---
import Layout from '../layouts/Layout.astro';
import { INITIAL_COLLECTIBLES } from '../data/collectibles';
import { API_URL } from '../lib/api';
---

<Layout 
  title="Private Wishlist & Saved Curations | RARIVELLE"
  description="Manage your confidential acquisition portfolio and saved museum-grade collectibles on RARIVELLE."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="border-b border-noir-800 pb-8 mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <span class="text-[11px] uppercase tracking-[0.3em] text-gold-400 font-semibold block mb-2">
          Confidential Acquisition Folio
        </span>
        <h1 class="font-serif text-3xl sm:text-5xl text-ivory-100 font-light">
          Saved Collectibles
        </h1>
        <p class="text-sm text-noir-400 mt-2 font-light">
          Monitor valuation movements, reserve status, and custodian updates on your curated shortlist.
        </p>
      </div>

      <!-- Portfolio Summary Metric Card -->
      <div id="wishlist-summary-card" class="bg-noir-900 border border-gold-500/30 px-6 py-4 flex items-center gap-8 shrink-0">
        <div>
          <div class="text-[10px] uppercase tracking-widest text-noir-400">Total Saved Pieces</div>
          <div id="total-count-display" class="font-serif text-2xl text-ivory-100 font-light">0</div>
        </div>
        <div class="border-l border-noir-800 pl-8">
          <div class="text-[10px] uppercase tracking-widest text-noir-400">Folio Valuation</div>
          <div id="total-valuation-display" class="font-serif text-2xl text-gold-300 font-light">$0</div>
        </div>
      </div>
    </div>

    <!-- Wishlist Items Grid -->
    <div id="wishlist-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Injected dynamically via client script -->
    </div>

    <!-- Empty State -->
    <div id="wishlist-empty" class="hidden text-center py-24 border border-noir-800 bg-noir-900/30 p-8 max-w-2xl mx-auto space-y-6">
      <div class="w-16 h-16 mx-auto rounded-full bg-noir-950 border border-noir-700 flex items-center justify-center text-noir-500">
        <svg class="w-8 h-8 text-gold-400/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
      </div>
      <div>
        <h3 class="font-serif text-2xl text-ivory-100 font-light mb-2">Your Private Folio is Unassigned</h3>
        <p class="text-xs text-noir-400 leading-relaxed font-light max-w-md mx-auto">
          You haven't archived any collectibles to your personal wishlist yet. Explore the salon catalog to earmark exceptional timepieces, manuscripts, or jewelry.
        </p>
      </div>
      <div>
        <a 
          href="/discover" 
          class="inline-block px-8 py-3.5 bg-gold-500 hover:bg-gold-400 text-noir-950 text-xs uppercase tracking-[0.2em] font-semibold transition-all"
        >
          Explore the Salon Catalog
        </a>
      </div>
    </div>

  </div>

  <!-- Client-side Wishlist Engine -->
  <script is:inline define:vars={{ staticItems: INITIAL_COLLECTIBLES, apiUrl: API_URL }}>
    (function() {
      // Phase 2B: also resolve live Products API items (deduped by id, API wins).
      let apiCache = null;
      let apiLoaded = false;

      async function fetchApiItems() {
        if (apiLoaded) return apiCache;
        apiLoaded = true;
        try {
          const res = await fetch(apiUrl + '?action=getProducts&status=active');
          const json = await res.json();
          if (json.success && Array.isArray(json.data)) {
            apiCache = json.data.map(p => ({
              id: p.productId,
              title: p.title,
              category: p.category,
              price: Number(p.price) || 0,
              condition: p.condition,
              location: p.location,
              year: p.year,
              images: p.images
            }));
          }
        } catch (e) {
          apiCache = [];
        }
        return apiCache || [];
      }

      function getAllAvailableItems() {
        let custom = [];
        try {
          const raw = localStorage.getItem('rarivelle_custom_listings');
          if (raw) custom = JSON.parse(raw);
        } catch (e) {}
        return [...custom, ...staticItems];
      }

      function getMergedWithApi(apiItems) {
        const seen = new Set(apiItems.map(i => i.id));
        return [...apiItems, ...getAllAvailableItems().filter(i => !seen.has(i.id))];
      }

      function formatUSD(amount) {
        return new Intl.NumberFormat('en-US', {
          style: 'currency',
          currency: 'USD',
          maximumFractionDigits: 0
        }).format(amount);
      }

      const grid = document.getElementById('wishlist-grid');
      const emptyState = document.getElementById('wishlist-empty');
      const countDisplay = document.getElementById('total-count-display');
      const valuationDisplay = document.getElementById('total-valuation-display');
      const summaryCard = document.getElementById('wishlist-summary-card');

      async function renderWishlist() {
        if (!grid) return;

        let wishlistIds = [];
        try {
          const raw = localStorage.getItem('rarivelle_wishlist');
          wishlistIds = raw ? JSON.parse(raw) : ['rv-101', 'rv-104'];
        } catch (e) {
          wishlistIds = [];
        }

        const apiItems = await fetchApiItems();
        const allItems = getMergedWithApi(apiItems);
        const savedItems = allItems.filter(item => wishlistIds.includes(item.id));

        if (countDisplay) countDisplay.textContent = String(savedItems.length);

        if (savedItems.length === 0) {
          grid.innerHTML = '';
          if (emptyState) emptyState.classList.remove('hidden');
          if (summaryCard) summaryCard.classList.add('opacity-50');
          if (valuationDisplay) valuationDisplay.textContent = '$0';
          return;
        }

        if (emptyState) emptyState.classList.add('hidden');
        if (summaryCard) summaryCard.classList.remove('opacity-50');

        const totalValuation = savedItems.reduce((acc, item) => acc + (Number(item.price) || 0), 0);
        if (valuationDisplay) valuationDisplay.textContent = formatUSD(totalValuation);

        grid.innerHTML = savedItems.map(item => {
          const img = (item.images && item.images[0]) ? item.images[0] : 'https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=1200&auto=format&fit=crop';
          return `
            <div class="group relative flex flex-col bg-noir-900 border border-noir-800 hover:border-gold-500/50 transition-all duration-300 overflow-hidden">
              <div class="relative aspect-4/3 w-full overflow-hidden bg-noir-950">
                <a href="/product/${item.id}" class="block w-full h-full">
                  <img 
                    src="${img}" 
                    alt="${item.title}" 
                    class="w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-500 brightness-90 group-hover:brightness-100"
                  />
                </a>
                <div class="absolute top-3 left-3">
                  <span class="inline-block px-2.5 py-1 text-[10px] uppercase tracking-widest font-semibold bg-noir-950/80 text-gold-300 border border-gold-500/30 backdrop-blur-md">
                    ${item.condition || 'Authenticated'}
                  </span>
                </div>
                <button 
                  type="button" 
                  data-remove-wishlist="${item.id}" 
                  class="absolute top-3 right-3 p-2 rounded-full bg-noir-950/80 text-ivory-300 hover:text-red-400 border border-white/10 hover:border-red-500/40 backdrop-blur-md transition-all cursor-pointer"
                  title="Remove from Folio"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>

              <div class="p-5 flex flex-col flex-1 justify-between space-y-4">
                <div>
                  <div class="flex items-center justify-between text-[11px] text-gold-400/80 uppercase tracking-widest mb-1">
                    <span>${item.category}</span>
                    <span>${item.year || ''}</span>
                  </div>
                  <h3 class="font-serif text-base font-normal text-ivory-100 group-hover:text-gold-300 transition-colors line-clamp-2">
                    <a href="/product/${item.id}">${item.title}</a>
                  </h3>
                  <div class="mt-2 text-xs text-noir-400">
                    Vault: ${item.location || 'Private Custody'}
                  </div>
                </div>

                <div class="pt-4 border-t border-noir-800/80 flex items-center justify-between">
                  <div>
                    <span class="block text-[9px] uppercase tracking-widest text-noir-400">Valuation</span>
                    <span class="font-serif text-lg text-gold-300 font-light">${formatUSD(item.price)}</span>
                  </div>
                  <a 
                    href="/product/${item.id}" 
                    class="px-3.5 py-1.5 border border-gold-500/40 text-gold-300 hover:bg-gold-500 hover:text-noir-950 text-[10px] uppercase tracking-widest font-semibold transition-colors"
                  >
                    View Dossier
                  </a>
                </div>
              </div>
            </div>
          `;
        }).join('');

        // Attach remove buttons
        grid.querySelectorAll('[data-remove-wishlist]').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-remove-wishlist');
            if (!id) return;
            try {
              const raw = localStorage.getItem('rarivelle_wishlist');
              let list = raw ? JSON.parse(raw) : [];
              list = list.filter(x => x !== id);
              localStorage.setItem('rarivelle_wishlist', JSON.stringify(list));
              window.dispatchEvent(new CustomEvent('rarivelle:wishlist-updated', { detail: { id, added: false, count: list.length } }));
              renderWishlist();
            } catch (err) {
              console.error(err);
            }
          });
        });
      }

      renderWishlist();
      window.addEventListener('rarivelle:wishlist-updated', renderWishlist);
    })();
  </script>
</Layout>
