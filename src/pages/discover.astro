---
import Layout from '../layouts/Layout.astro';
import { CATEGORIES, INITIAL_COLLECTIBLES } from '../data/collectibles';
---

<Layout 
  title="Discover Collectibles | RARIVELLE Marketplace"
  description="Explore authenticated rare timepieces, historical coins, signed first editions, and estate jewelry with full provenance."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header Title & Subtext -->
    <div class="border-b border-noir-800 pb-8 mb-10">
      <span class="text-[11px] uppercase tracking-[0.25em] text-gold-400 font-medium block mb-2">
        The Open Salon Catalog
      </span>
      <h1 class="font-serif text-3xl sm:text-5xl text-ivory-100 font-light">
        Discover Rare Masterpieces
      </h1>
      <p class="text-sm text-noir-400 mt-2 max-w-2xl font-light">
        Curated antiquities, haute horology, and museum-grade objects available for direct collector acquisition and private treaty.
      </p>
    </div>

    <!-- Main Marketplace Layout: Sidebar Filters + Products Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      
      <!-- Filters Sidebar -->
      <aside class="lg:col-span-1 space-y-8">
        <div class="bg-noir-900/80 border border-noir-800 p-6 space-y-6 sticky top-28">
          <div class="flex items-center justify-between pb-4 border-b border-noir-800">
            <h3 class="font-serif text-sm uppercase tracking-widest text-ivory-100 font-medium">Refine Catalog</h3>
            <button 
              id="reset-filters-btn" 
              type="button" 
              class="text-[10px] uppercase tracking-wider text-gold-400 hover:text-gold-300 underline underline-offset-4 cursor-pointer"
            >
              Reset All
            </button>
          </div>

          <!-- Live Search Input -->
          <div>
            <label for="search-input" class="block text-[11px] uppercase tracking-wider text-noir-400 mb-2">Keyword Search</label>
            <div class="relative">
              <input 
                type="text" 
                id="search-input" 
                placeholder="Search maker, title, ref..." 
                class="w-full bg-noir-950 border border-noir-700 px-3.5 py-2.5 text-xs text-ivory-100 placeholder-noir-500 focus:outline-none focus:border-gold-500 transition-colors"
              />
              <svg class="w-4 h-4 text-noir-500 absolute right-3 top-3 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
          </div>

          <!-- Category Filter -->
          <div>
            <label for="category-select" class="block text-[11px] uppercase tracking-wider text-noir-400 mb-2">Department</label>
            <select 
              id="category-select" 
              class="w-full bg-noir-950 border border-noir-700 px-3 py-2.5 text-xs text-ivory-100 focus:outline-none focus:border-gold-500 transition-colors cursor-pointer"
            >
              <option value="all">All Departments</option>
              {CATEGORIES.map(cat => (
                <option value={cat.name}>{cat.name}</option>
              ))}
            </select>
          </div>

          <!-- Condition Filter -->
          <div>
            <label class="block text-[11px] uppercase tracking-wider text-noir-400 mb-2.5">Condition Grade</label>
            <div class="space-y-2 text-xs">
              {['Museum Grade', 'Near Mint', 'Excellent', 'Restored Historic'].map(cond => (
                <label class="flex items-center gap-2.5 text-ivory-300/80 hover:text-ivory-100 cursor-pointer">
                  <input 
                    type="checkbox" 
                    name="condition" 
                    value={cond} 
                    class="condition-checkbox w-3.5 h-3.5 rounded-none bg-noir-950 border-noir-700 text-gold-500 focus:ring-0 focus:ring-offset-0"
                  />
                  <span>{cond}</span>
                </label>
              ))}
            </div>
          </div>

          <!-- Price Range Filter -->
          <div>
            <div class="flex justify-between items-center mb-2">
              <label class="block text-[11px] uppercase tracking-wider text-noir-400">Max Valuation</label>
              <span id="price-display" class="font-serif text-xs text-gold-400 font-medium">$500,000</span>
            </div>
            <input 
              type="range" 
              id="price-range" 
              min="20000" 
              max="500000" 
              step="10000" 
              value="500000"
              class="w-full accent-gold-500 bg-noir-800 cursor-pointer"
            />
            <div class="flex justify-between text-[10px] text-noir-500 mt-1">
              <span>$20k</span>
              <span>$250k</span>
              <span>$500k+</span>
            </div>
          </div>

          <!-- Location Filter -->
          <div>
            <label for="location-select" class="block text-[11px] uppercase tracking-wider text-noir-400 mb-2">Vault Location</label>
            <select 
              id="location-select" 
              class="w-full bg-noir-950 border border-noir-700 px-3 py-2.5 text-xs text-ivory-100 focus:outline-none focus:border-gold-500 transition-colors cursor-pointer"
            >
              <option value="all">All Global Locations</option>
              <option value="Switzerland">Switzerland (Geneva / Zurich)</option>
              <option value="UK">United Kingdom (London)</option>
              <option value="USA">United States (New York / Philadelphia / Nashville)</option>
              <option value="France">France (Paris)</option>
              <option value="Italy">Italy (Rome / Modena)</option>
              <option value="Japan">Japan (Kyoto)</option>
              <option value="Germany">Germany (Wetzlar / Frankfurt)</option>
            </select>
          </div>

          <!-- Rare Finds Only Checkbox -->
          <div class="pt-2 border-t border-noir-800">
            <label class="flex items-center gap-2.5 text-xs text-gold-300 font-medium cursor-pointer">
              <input 
                type="checkbox" 
                id="rare-only-check" 
                class="w-3.5 h-3.5 bg-noir-950 border-noir-700 text-gold-500 focus:ring-0"
              />
              <span>Rare Finds Only</span>
            </label>
          </div>
        </div>
      </aside>

      <!-- Marketplace Grid Content -->
      <section class="lg:col-span-3">
        <!-- Control Bar: Sort & Counter -->
        <div class="bg-noir-900/60 border border-noir-800 p-4 mb-6 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-xs text-noir-400">
            Showing <span id="results-count" class="text-ivory-100 font-semibold">{INITIAL_COLLECTIBLES.length}</span> pieces
          </div>

          <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
            <label for="sort-select" class="text-[11px] uppercase tracking-wider text-noir-400 shrink-0">Sort By:</label>
            <select 
              id="sort-select" 
              class="bg-noir-950 border border-noir-700 px-3 py-1.5 text-xs text-ivory-100 focus:outline-none focus:border-gold-500 transition-colors cursor-pointer"
            >
              <option value="featured">Curated & Featured</option>
              <option value="price-low">Valuation: Low to High</option>
              <option value="price-high">Valuation: High to Low</option>
              <option value="newest">Recently Cataloged</option>
              <option value="year-old">Historical Age: Oldest First</option>
            </select>
          </div>
        </div>

        <!-- Dynamic Collectibles Grid -->
        <div 
          id="collectibles-grid" 
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
        >
          <!-- Filled dynamically via client script with initial SSR fallback -->
        </div>

        <!-- No Results Fallback -->
        <div id="no-results" class="hidden text-center py-20 border border-dashed border-noir-800 bg-noir-900/30 p-8">
          <svg class="w-12 h-12 text-noir-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h3 class="font-serif text-xl text-ivory-200 mb-2">No Matching Collectibles</h3>
          <p class="text-xs text-noir-400 max-w-sm mx-auto mb-6">
            We couldn't find any pieces matching your current filters. Try relaxing your valuation or search keywords.
          </p>
          <button 
            type="button" 
            id="reset-empty-btn" 
            class="px-6 py-2.5 bg-gold-500 text-noir-950 text-xs uppercase tracking-wider font-semibold hover:bg-gold-400 transition-colors"
          >
            Clear All Filters
          </button>
        </div>
      </section>

    </div>
  </div>

  <!-- Client-side Search, Filter & Render Script -->
  <script is:inline define:vars={{ initialItems: INITIAL_COLLECTIBLES }}>
    (function() {
      // Merge with custom listings in localStorage
      function getMergedItems() {
        let custom = [];
        try {
          const raw = localStorage.getItem('rarivelle_custom_listings');
          if (raw) custom = JSON.parse(raw);
        } catch (e) {}
        return [...custom, ...initialItems];
      }

      function formatUSD(val) {
        return new Intl.NumberFormat('en-US', {
          style: 'currency',
          currency: 'USD',
          maximumFractionDigits: 0
        }).format(val);
      }

      const grid = document.getElementById('collectibles-grid');
      const countEl = document.getElementById('results-count');
      const noResults = document.getElementById('no-results');
      const searchInput = document.getElementById('search-input');
      const categorySelect = document.getElementById('category-select');
      const priceRange = document.getElementById('price-range');
      const priceDisplay = document.getElementById('price-display');
      const locationSelect = document.getElementById('location-select');
      const rareCheck = document.getElementById('rare-only-check');
      const sortSelect = document.getElementById('sort-select');
      const resetBtn = document.getElementById('reset-filters-btn');
      const resetEmptyBtn = document.getElementById('reset-empty-btn');

      // Check URL parameters for preset category or filter
      const urlParams = new URLSearchParams(window.location.search);
      const urlCat = urlParams.get('category');
      const urlFilter = urlParams.get('filter');
      const urlSort = urlParams.get('sort');

      if (urlCat && categorySelect) {
        categorySelect.value = urlCat;
      }
      if (urlFilter === 'rare' && rareCheck) {
        rareCheck.checked = true;
      }
      if (urlSort && sortSelect) {
        sortSelect.value = urlSort;
      }

      function renderItems(items) {
        if (!grid) return;

        if (items.length === 0) {
          grid.innerHTML = '';
          if (noResults) noResults.classList.remove('hidden');
          if (countEl) countEl.textContent = '0';
          return;
        }

        if (noResults) noResults.classList.add('hidden');
        if (countEl) countEl.textContent = String(items.length);

        grid.innerHTML = items.map(item => {
          const primaryImage = (item.images && item.images[0]) ? item.images[0] : 'https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=1200&auto=format&fit=crop';
          const verifiedIcon = item.seller && item.seller.verified ? `
            <svg class="w-3.5 h-3.5 text-gold-400 shrink-0 inline" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>` : '';

          const rareBadge = item.rareFind ? `
            <span class="inline-block px-2 py-0.5 text-[9px] uppercase tracking-widest font-medium bg-gold-500 text-noir-950">
              Rare Find
            </span>` : '';

          return `
            <div class="group relative flex flex-col bg-noir-900/60 border border-noir-800 hover:border-gold-500/50 transition-all duration-300 overflow-hidden">
              <div class="relative aspect-square w-full overflow-hidden bg-noir-950">
                <a href="/product/${item.id}" class="block w-full h-full">
                  <img 
                    src="${primaryImage}" 
                    alt="${item.title}" 
                    loading="lazy" 
                    class="w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-700 ease-out brightness-90 group-hover:brightness-100"
                  />
                </a>
                <div class="absolute top-3 left-3 flex flex-col gap-1.5 pointer-events-none">
                  <span class="inline-block px-2.5 py-1 text-[10px] uppercase tracking-widest font-semibold bg-noir-950/80 text-gold-300 border border-gold-500/30 backdrop-blur-md">
                    ${item.condition || 'Authenticated'}
                  </span>
                  ${rareBadge}
                </div>
                <button 
                  type="button" 
                  data-wishlist-btn="${item.id}" 
                  data-item-title="${item.title}" 
                  aria-label="Save to Wishlist" 
                  class="wishlist-btn absolute top-3 right-3 p-2.5 rounded-full bg-noir-950/70 hover:bg-noir-950 text-ivory-300 hover:text-gold-400 border border-white/10 hover:border-gold-500/50 backdrop-blur-md transition-all duration-200 cursor-pointer z-10"
                >
                  <svg class="w-4 h-4 heart-icon transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                  </svg>
                </button>
              </div>

              <div class="p-5 flex flex-col flex-1 justify-between bg-gradient-to-b from-noir-900/40 to-noir-900/90">
                <div>
                  <div class="flex items-center justify-between text-[11px] text-gold-400/80 uppercase tracking-widest mb-1.5">
                    <span>${item.category}</span>
                    <span>${item.year || ''}</span>
                  </div>
                  <h3 class="font-serif text-base font-normal text-ivory-100 group-hover:text-gold-300 transition-colors duration-200 line-clamp-2 leading-snug">
                    <a href="/product/${item.id}">${item.title}</a>
                  </h3>
                  <div class="mt-2.5 flex items-center gap-1.5 text-xs text-noir-400">
                    <svg class="w-3.5 h-3.5 text-noir-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span class="truncate">${item.location || 'Vault Curated'}</span>
                  </div>
                </div>

                <div class="mt-5 pt-4 border-t border-noir-800/80 flex items-center justify-between">
                  <div>
                    <span class="block text-[9px] uppercase tracking-widest text-noir-400">Valuation</span>
                    <span class="font-serif text-lg text-gold-300 font-light tracking-wide">${formatUSD(item.price)}</span>
                  </div>
                  <div class="text-right">
                    <span class="block text-[9px] uppercase tracking-widest text-noir-400">Custodian</span>
                    <div class="flex items-center gap-1 text-xs text-ivory-300/90 font-medium">
                      <span class="truncate max-w-[110px]">${(item.seller && item.seller.name) ? item.seller.name : 'Private Collector'}</span>
                      ${verifiedIcon}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          `;
        }).join('');

        // Trigger global wishlist sync
        if (window.dispatchEvent) {
          window.dispatchEvent(new CustomEvent('rarivelle:wishlist-updated'));
        }
      }

      function applyFilters() {
        const allItems = getMergedItems();
        const search = (searchInput && searchInput.value) ? searchInput.value.toLowerCase().trim() : '';
        const cat = (categorySelect && categorySelect.value) ? categorySelect.value : 'all';
        const maxPrice = priceRange ? Number(priceRange.value) : 500000;
        const loc = (locationSelect && locationSelect.value) ? locationSelect.value : 'all';
        const rareOnly = rareCheck ? rareCheck.checked : false;
        const sort = (sortSelect && sortSelect.value) ? sortSelect.value : 'featured';

        const checkedConditions = Array.from(document.querySelectorAll('.condition-checkbox:checked'))
          .map(cb => cb.value);

        let filtered = allItems.filter(item => {
          // Search filter
          if (search) {
            const matchTitle = item.title && item.title.toLowerCase().includes(search);
            const matchBrand = item.brand && item.brand.toLowerCase().includes(search);
            const matchCat = item.category && item.category.toLowerCase().includes(search);
            const matchDesc = item.description && item.description.toLowerCase().includes(search);
            const matchSeller = item.seller && item.seller.name && item.seller.name.toLowerCase().includes(search);
            if (!matchTitle && !matchBrand && !matchCat && !matchDesc && !matchSeller) return false;
          }

          // Category filter
          if (cat !== 'all' && item.category !== cat) {
            return false;
          }

          // Price filter
          if (item.price > maxPrice) {
            return false;
          }

          // Condition filter
          if (checkedConditions.length > 0 && !checkedConditions.includes(item.condition)) {
            return false;
          }

          // Location filter
          if (loc !== 'all') {
            if (!item.location || !item.location.toLowerCase().includes(loc.toLowerCase())) {
              return false;
            }
          }

          // Rare finds only
          if (rareOnly && !item.rareFind) {
            return false;
          }

          return true;
        });

        // Sorting
        filtered.sort((a, b) => {
          if (sort === 'price-low') return a.price - b.price;
          if (sort === 'price-high') return b.price - a.price;
          if (sort === 'newest') return (b.recentlyListed ? 1 : 0) - (a.recentlyListed ? 1 : 0);
          if (sort === 'year-old') {
            const yA = typeof a.year === 'number' ? a.year : parseInt(String(a.year)) || 2000;
            const yB = typeof b.year === 'number' ? b.year : parseInt(String(b.year)) || 2000;
            return yA - yB;
          }
          // Default featured
          return (b.featured ? 1 : 0) - (a.featured ? 1 : 0);
        });

        renderItems(filtered);
      }

      function resetAll() {
        if (searchInput) searchInput.value = '';
        if (categorySelect) categorySelect.value = 'all';
        if (priceRange) {
          priceRange.value = '500000';
          if (priceDisplay) priceDisplay.textContent = '$500,000';
        }
        if (locationSelect) locationSelect.value = 'all';
        if (rareCheck) rareCheck.checked = false;
        if (sortSelect) sortSelect.value = 'featured';
        document.querySelectorAll('.condition-checkbox').forEach(cb => {
          cb.checked = false;
        });
        applyFilters();
      }

      // Event listeners
      if (searchInput) searchInput.addEventListener('input', applyFilters);
      if (categorySelect) categorySelect.addEventListener('change', applyFilters);
      if (locationSelect) locationSelect.addEventListener('change', applyFilters);
      if (rareCheck) rareCheck.addEventListener('change', applyFilters);
      if (sortSelect) sortSelect.addEventListener('change', applyFilters);
      if (resetBtn) resetBtn.addEventListener('click', resetAll);
      if (resetEmptyBtn) resetEmptyBtn.addEventListener('click', resetAll);

      document.querySelectorAll('.condition-checkbox').forEach(cb => {
        cb.addEventListener('change', applyFilters);
      });

      if (priceRange) {
        priceRange.addEventListener('input', () => {
          if (priceDisplay) priceDisplay.textContent = formatUSD(Number(priceRange.value));
          applyFilters();
        });
      }

      // Initial run
      applyFilters();
    })();
  </script>
</Layout>
