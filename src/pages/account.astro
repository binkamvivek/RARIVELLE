---
import Layout from '../layouts/Layout.astro';
import { API_URL } from '../lib/api';

export const prerender = true;
---

<Layout 
  title="The Vault | Collector Dashboard & Portfolio | RARIVELLE"
  description="Manage your active consignments, acquired artifacts, and institutional verification status on RARIVELLE."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Collector Header Banner -->
    <div class="bg-noir-900 border border-noir-800 p-8 sm:p-10 mb-12 relative overflow-hidden">
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-gold-500/5 rounded-full blur-2xl pointer-events-none"></div>

      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
        <!-- Collector Avatar & Info -->
        <div class="flex items-center gap-6">
          <div class="relative">
            <img 
              src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=300&auto=format&fit=crop" 
              alt="Collector Avatar" 
              class="w-20 h-20 sm:w-24 sm:h-24 rounded-full object-cover border-2 border-gold-500/50 shadow-xl"
            />
            <span class="absolute bottom-1 right-1 w-5 h-5 bg-gold-500 text-noir-950 rounded-full flex items-center justify-center text-[10px] font-bold" title="Verified Tier-1">
              ✓
            </span>
          </div>

          <div class="space-y-1.5">
            <div class="flex items-center gap-2.5">
              <span class="text-[10px] uppercase tracking-[0.25em] text-gold-400 font-semibold block mb-1">Collector</span>
            </div>
            <h1 id="account-user-name" class="font-serif text-2xl sm:text-3xl text-ivory-100 font-light">
              Welcome
            </h1>
            <p id="account-user-email" class="text-xs text-noir-400">
              Member of RARIVELLE
            </p>
            <a id="account-profile-link" href="/account" class="text-[11px] text-gold-400 hover:text-gold-300 underline underline-offset-4 transition-colors">
              View public profile &rarr;
            </a>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap items-center gap-3">
          <a 
            href="/sell" 
            class="px-5 py-3 bg-gold-500 hover:bg-gold-400 text-noir-950 text-xs uppercase tracking-widest font-semibold transition-all shadow-md"
          >
            + Consign New Piece
          </a>
          <a
            href="/wishlist"
            class="px-5 py-3 bg-noir-950 hover:bg-noir-850 text-ivory-200 border border-noir-700 text-xs uppercase tracking-widest font-medium transition-all"
          >
            Saved Folio
          </a>
          <a
            href="/messages"
            class="px-5 py-3 bg-noir-950 hover:bg-noir-850 text-ivory-200 border border-noir-700 text-xs uppercase tracking-widest font-medium transition-all"
          >
            Messages
          </a>
          <button
            id="account-signout-btn"
            type="button"
            class="px-5 py-3 bg-transparent border border-noir-700 hover:border-red-500/50 text-noir-400 hover:text-red-400 text-xs uppercase tracking-widest font-medium transition-all"
          >
            Sign Out
          </button>
        </div>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="mt-8 pt-8 border-t border-noir-800/80 grid grid-cols-2 sm:grid-cols-4 gap-6">
        <div>
          <span class="block text-[10px] uppercase tracking-widest text-noir-400">Consigned Pieces</span>
          <span id="account-listings-count" class="font-serif text-2xl text-ivory-100 font-light">0</span>
        </div>
        <div>
          <span class="block text-[10px] uppercase tracking-widest text-noir-400">Vault Valuation</span>
          <span id="account-valuation" class="font-serif text-2xl text-gold-300 font-light">$0</span>
        </div>
        <div>
          <span class="block text-[10px] uppercase tracking-widest text-noir-400">Salon Escrows</span>
          <span class="font-serif text-2xl text-ivory-100 font-light">14 Completed</span>
        </div>
        <div>
          <span class="block text-[10px] uppercase tracking-widest text-noir-400">Collector Rating</span>
          <span class="font-serif text-2xl text-gold-300 font-light">5.0 ★</span>
        </div>
      </div>
    </div>

    <!-- Seller Profile Editor -->
    <div class="mb-12 p-6 sm:p-8 bg-noir-900/60 border border-noir-800">
      <span class="text-[10px] uppercase tracking-[0.25em] text-gold-400 font-semibold block mb-1">Public Seller Profile</span>
      <h2 class="font-serif text-2xl text-ivory-100 font-light mb-6">Edit Profile</h2>

      <div id="profile-msg" class="hidden mb-4 px-4 py-3 text-xs tracking-wide" role="status"></div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="profile-name" class="block text-[11px] uppercase tracking-wider text-noir-400 mb-1.5">Display Name</label>
          <input
            id="profile-name"
            type="text"
            placeholder="Your name or collection name"
            class="w-full bg-noir-950 border border-noir-700 px-3.5 py-2.5 text-xs text-ivory-100 placeholder-noir-500 focus:outline-none focus:border-gold-500 transition-colors"
          />
        </div>
        <div>
          <label for="profile-location" class="block text-[11px] uppercase tracking-wider text-noir-400 mb-1.5">Location</label>
          <input
            id="profile-location"
            type="text"
            placeholder="e.g. Geneva, Switzerland"
            class="w-full bg-noir-950 border border-noir-700 px-3.5 py-2.5 text-xs text-ivory-100 placeholder-noir-500 focus:outline-none focus:border-gold-500 transition-colors"
          />
        </div>
        <div class="sm:col-span-2">
          <label for="profile-avatar" class="block text-[11px] uppercase tracking-wider text-noir-400 mb-1.5">Profile Image URL</label>
          <input
            id="profile-avatar"
            type="url"
            placeholder="https://example.com/portrait.jpg"
            class="w-full bg-noir-950 border border-noir-700 px-3.5 py-2.5 text-xs text-ivory-100 placeholder-noir-500 focus:outline-none focus:border-gold-500 transition-colors"
          />
        </div>
        <div class="sm:col-span-2">
          <label for="profile-bio" class="block text-[11px] uppercase tracking-wider text-noir-400 mb-1.5">Bio</label>
          <textarea
            id="profile-bio"
            rows="3"
            placeholder="A short note on your collection focus and expertise…"
            class="w-full bg-noir-950 border border-noir-700 p-3.5 text-xs text-ivory-100 placeholder-noir-500 focus:outline-none focus:border-gold-500 transition-colors leading-relaxed"
          ></textarea>
        </div>
      </div>

      <div class="mt-5">
        <button
          id="profile-save-btn"
          type="button"
          class="px-6 py-3 bg-gold-500 hover:bg-gold-400 text-noir-950 text-xs uppercase tracking-widest font-semibold transition-all disabled:opacity-60 disabled:cursor-not-allowed"
        >
          Save Profile
        </button>
      </div>
    </div>

    <!-- Active Consignments Section -->
    <div class="space-y-6">
      <div class="flex items-center justify-between pb-4 border-b border-noir-800">
        <div>
          <span class="text-[10px] uppercase tracking-[0.25em] text-gold-400 font-semibold block mb-1">Your Portfolio</span>
          <h2 class="font-serif text-2xl text-ivory-100 font-light">Active Consignments & Salon Listings</h2>
        </div>
        <a 
          href="/sell" 
          class="text-xs uppercase tracking-wider text-gold-400 hover:text-gold-300 underline underline-offset-4"
        >
          Add Another Listing
        </a>
      </div>

      <!-- Grid of User Listings -->
      <div id="user-listings-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Rendered dynamically -->
      </div>

      <!-- Empty State for User Listings -->
      <div id="no-user-listings" class="hidden text-center py-16 border border-dashed border-noir-800 bg-noir-900/30 p-8">
        <svg class="w-10 h-10 text-noir-600 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="font-serif text-lg text-ivory-200 mb-1">No Active Pieces Listed Currently</h3>
        <p class="text-xs text-noir-400 max-w-sm mx-auto mb-6">
          You haven't listed any rare pieces in the salon yet. Use our listing creator to present your collectible to serious patrons.
        </p>
        <a 
          href="/sell" 
          class="inline-block px-6 py-3 bg-gold-500 text-noir-950 text-xs uppercase tracking-wider font-semibold hover:bg-gold-400 transition-colors"
        >
          Create First Listing
        </a>
      </div>
    </div>

    <!-- Collector Status & Security Enclave Section -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 bg-noir-900/60 border border-noir-800 space-y-3">
        <div class="text-gold-400 font-serif text-xs uppercase tracking-wider font-semibold">Tier-1 AML & Custody Verified</div>
        <p class="text-xs text-noir-400 leading-relaxed font-light">
          Your identity and institutional banking credentials are valid through December 2027. Escrow settlements clear without secondary holds.
        </p>
      </div>

      <div class="p-6 bg-noir-900/60 border border-noir-800 space-y-3">
        <div class="text-gold-400 font-serif text-xs uppercase tracking-wider font-semibold">Insured Storage Access</div>
        <p class="text-xs text-noir-400 leading-relaxed font-light">
          Geneva FreePort & Knightsbridge Safe Deposit access codes are synced with your biometric collector pass.
        </p>
      </div>

      <div class="p-6 bg-noir-900/60 border border-noir-800 space-y-3">
        <div class="text-gold-400 font-serif text-xs uppercase tracking-wider font-semibold">Private Viewing Concierge</div>
        <p class="text-xs text-noir-400 leading-relaxed font-light">
          Need an armored courier or private viewing salon in Zurich or Paris? Contact your dedicated liaison at <span class="text-gold-400">concierge@rarivelle.com</span>.
        </p>
      </div>
    </div>

  </div>

  <!-- Client-side script to load user's listings from the Products API + auth gate -->
  <script is:inline define:vars={{ apiUrl: API_URL }}>
    (function() {
      // --- Auth Gate ---
      var rawUser = localStorage.getItem('rarivelle_user');
      var user = null;
      try { user = rawUser ? JSON.parse(rawUser) : null; } catch(e) {}

      if (!user || !user.userId) {
        window.location.href = '/login';
        return;
      }

      // Populate user info
      var nameEl = document.getElementById('account-user-name');
      var emailEl = document.getElementById('account-user-email');
      if (nameEl) nameEl.textContent = user.name || 'Collector';
      if (emailEl) emailEl.textContent = user.email || '';

      // Sign out
      document.getElementById('account-signout-btn')?.addEventListener('click', function() {
        localStorage.removeItem('rarivelle_user');
        window.dispatchEvent(new CustomEvent('rarivelle:auth-updated'));
        window.location.href = '/';
      });

      // Public profile link
      var profileLink = document.getElementById('account-profile-link');
      if (profileLink) profileLink.setAttribute('href', '/seller/' + encodeURIComponent(user.userId));

      // --- Edit Profile (Phase 2D, own profile only) ---
      var profileName = document.getElementById('profile-name');
      var profileLocation = document.getElementById('profile-location');
      var profileAvatar = document.getElementById('profile-avatar');
      var profileBio = document.getElementById('profile-bio');
      var profileSaveBtn = document.getElementById('profile-save-btn');
      var profileMsg = document.getElementById('profile-msg');

      function showProfileMsg(text, ok) {
        if (!profileMsg) return;
        profileMsg.textContent = text;
        profileMsg.classList.remove('hidden');
        profileMsg.className = 'mb-4 px-4 py-3 text-xs tracking-wide ' + (ok
          ? 'border border-emerald-500/30 bg-emerald-950/40 text-emerald-400'
          : 'border border-red-500/30 bg-red-950/40 text-red-400');
      }

      // Prefill from live profile
      fetch(apiUrl + '?action=getSellerProfile&userId=' + encodeURIComponent(user.userId))
        .then(function(res) { return res.json(); })
        .then(function(json) {
          if (json.success && json.data) {
            if (profileName) profileName.value = json.data.name || '';
            if (profileLocation) profileLocation.value = json.data.location || '';
            if (profileAvatar) profileAvatar.value = json.data.avatarUrl || '';
            if (profileBio) profileBio.value = json.data.bio || '';
          }
        })
        .catch(function() {});

      if (profileSaveBtn) {
        profileSaveBtn.addEventListener('click', function() {
          var updates = {
            name: profileName ? profileName.value.trim() : '',
            location: profileLocation ? profileLocation.value.trim() : '',
            avatarUrl: profileAvatar ? profileAvatar.value.trim() : '',
            bio: profileBio ? profileBio.value.trim() : ''
          };
          if (!updates.name) {
            showProfileMsg('Display name cannot be empty.', false);
            return;
          }
          if (updates.avatarUrl && !/^https?:\/\/.+/i.test(updates.avatarUrl)) {
            showProfileMsg('Profile image must be a valid https URL (or left empty).', false);
            return;
          }

          profileSaveBtn.disabled = true;
          profileSaveBtn.textContent = 'Saving…';

          fetch(apiUrl, {
            method: 'POST',
            body: JSON.stringify({ action: 'updateProfile', userId: user.userId, ...updates })
          }).then(function(res) { return res.json(); }).then(function(json) {
            profileSaveBtn.disabled = false;
            profileSaveBtn.textContent = 'Save Profile';
            if (json.success && json.data) {
              // Refresh header + session so navbar/discover attribution update
              if (nameEl) nameEl.textContent = json.data.name || 'Collector';
              try {
                var raw = localStorage.getItem('rarivelle_user');
                var session = raw ? JSON.parse(raw) : {};
                session.name = json.data.name;
                localStorage.setItem('rarivelle_user', JSON.stringify(session));
                window.dispatchEvent(new CustomEvent('rarivelle:auth-updated'));
              } catch (e) {}
              showProfileMsg('Profile saved.', true);
            } else {
              showProfileMsg(json.error || 'Unable to save profile.', false);
            }
          }).catch(function() {
            profileSaveBtn.disabled = false;
            profileSaveBtn.textContent = 'Save Profile';
            showProfileMsg('Unable to reach the server. Please try again.', false);
          });
        });
      }

      // --- Listings (Phase 2B: Products API, history preserved via status) ---
      var grid = document.getElementById('user-listings-grid');
      var emptyState = document.getElementById('no-user-listings');
      var countEl = document.getElementById('account-listings-count');
      var valEl = document.getElementById('account-valuation');

      function formatUSD(amount) {
        return new Intl.NumberFormat('en-US', {
          style: 'currency',
          currency: 'USD',
          maximumFractionDigits: 0
        }).format(amount);
      }

      function escapeHtml(s) {
        return String(s || '').replace(/[&<>"']/g, function(c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }

      var FALLBACK_IMG = 'https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=1200&auto=format&fit=crop';

      function safeImageUrl(u) {
        var s = String(u || '').trim();
        return /^https?:\/\/.+/i.test(s) ? s : FALLBACK_IMG;
      }

      function statusBadge(status) {
        if (status === 'sold') {
          return '<span class="absolute top-3 left-3 px-2 py-0.5 text-[9px] uppercase tracking-widest bg-gold-500 text-noir-950 font-semibold">Sold</span>';
        }
        if (status === 'delisted') {
          return '<span class="absolute top-3 left-3 px-2 py-0.5 text-[9px] uppercase tracking-widest bg-noir-950/80 text-noir-400 border border-noir-700 font-semibold backdrop-blur-sm">Delisted</span>';
        }
        return '<span class="absolute top-3 left-3 px-2 py-0.5 text-[9px] uppercase tracking-widest bg-emerald-950/80 text-emerald-400 border border-emerald-500/30 font-semibold backdrop-blur-sm">Active in Salon</span>';
      }

      function setStatus(productId, status, confirmMsg) {
        if (confirmMsg && !confirm(confirmMsg)) return;
        fetch(apiUrl, {
          method: 'POST',
          body: JSON.stringify({ action: 'updateProduct', productId: productId, sellerId: user.userId, status: status })
        }).then(function(res) { return res.json(); }).then(function(json) {
          if (json.success) {
            loadListings();
          } else {
            alert(json.error || 'Unable to update listing.');
          }
        }).catch(function() {
          alert('Unable to reach the server. Please try again.');
        });
      }

      function renderListings(list) {
        if (countEl) countEl.textContent = String(list.length);

        if (list.length === 0) {
          if (grid) grid.innerHTML = '';
          if (emptyState) emptyState.classList.remove('hidden');
          if (valEl) valEl.textContent = '$0';
          return;
        }

        if (emptyState) emptyState.classList.add('hidden');

        var activeTotal = list.reduce(function(acc, item) {
          return acc + (item.status === 'active' ? (Number(item.price) || 0) : 0);
        }, 0);
        if (valEl) valEl.textContent = formatUSD(activeTotal);

        if (grid) {
          grid.innerHTML = list.map(function(item) {
            var img = safeImageUrl(item.images && item.images[0]);
            var pid = encodeURIComponent(item.productId);
            var itemHref = '/product/' + pid;
            var statusActions = '';
            if (item.status === 'active') {
              statusActions =
                '<button type="button" data-status-action="sold" data-product-id="' + escapeHtml(item.productId) + '" class="px-3 py-1 bg-noir-950 border border-gold-500/40 text-gold-300 hover:bg-gold-500 hover:text-noir-950 text-[10px] uppercase tracking-widest font-semibold transition-colors cursor-pointer">Mark Sold</button>' +
                '<button type="button" data-status-action="delisted" data-product-id="' + escapeHtml(item.productId) + '" class="px-3 py-1 bg-transparent border border-noir-700 text-noir-400 hover:text-red-400 hover:border-red-500/40 text-[10px] uppercase tracking-widest font-semibold transition-colors cursor-pointer">Delist</button>';
            } else {
              statusActions =
                '<button type="button" data-status-action="active" data-product-id="' + escapeHtml(item.productId) + '" class="px-3 py-1 bg-noir-950 border border-emerald-500/40 text-emerald-400 hover:bg-emerald-500 hover:text-noir-950 text-[10px] uppercase tracking-widest font-semibold transition-colors cursor-pointer">Relist</button>';
            }
            return [
              '<div class="bg-noir-900 border border-noir-800 hover:border-gold-500/50 transition-all flex flex-col justify-between overflow-hidden">',
                '<div class="relative aspect-4/3 w-full bg-noir-950 overflow-hidden">',
                  '<img src="' + img + '" alt="' + escapeHtml(item.title) + '" class="w-full h-full object-cover" />',
                  statusBadge(item.status),
                '</div>',
                '<div class="p-5 flex flex-col flex-1 justify-between space-y-4">',
                  '<div>',
                    '<div class="text-[10px] text-gold-400 uppercase tracking-widest mb-1">' + escapeHtml(item.category) + ' · Circa ' + escapeHtml(item.year || 'Historic') + '</div>',
                    '<h3 class="font-serif text-base text-ivory-100 line-clamp-2"><a href="' + itemHref + '">' + escapeHtml(item.title) + '</a></h3>',
                    '<div class="text-xs text-noir-400 mt-1">Vault: ' + escapeHtml(item.location || 'Your Custody') + '</div>',
                  '</div>',
                  '<div class="pt-4 border-t border-noir-800 flex items-center justify-between">',
                    '<div>',
                      '<span class="block text-[9px] uppercase tracking-widest text-noir-400">Listed Price</span>',
                      '<span class="font-serif text-lg text-gold-300 font-light">' + formatUSD(item.price) + '</span>',
                    '</div>',
                    '<a href="/sell?edit=' + pid + '" class="px-3 py-1 bg-noir-950 border border-gold-500/40 text-gold-300 hover:bg-gold-500 hover:text-noir-950 text-[10px] uppercase tracking-widest font-semibold transition-colors">Edit</a>',
                  '</div>',
                  '<div class="flex flex-wrap gap-2">',
                    statusActions,
                  '</div>',
                '</div>',
              '</div>'
            ].join('');
          }).join('');

          // Attach status listeners (soft status changes only — rows are never deleted)
          grid.querySelectorAll('[data-status-action]').forEach(function(btn) {
            btn.addEventListener('click', function() {
              var pid = btn.getAttribute('data-product-id');
              var next = btn.getAttribute('data-status-action');
              if (next === 'delisted') {
                setStatus(pid, next, 'Withdraw this piece from the salon? History is preserved.');
              } else if (next === 'sold') {
                setStatus(pid, next, 'Mark this piece as sold?');
              } else {
                setStatus(pid, next, null);
              }
            });
          });
        }
      }

      function loadListings() {
        if (grid) grid.innerHTML = '<p class="text-xs text-noir-400 col-span-full">Loading your portfolio…</p>';
        fetch(apiUrl + '?action=getProducts&sellerId=' + encodeURIComponent(user.userId) + '&status=all')
          .then(function(res) { return res.json(); })
          .then(function(json) {
            if (json.success && Array.isArray(json.data)) {
              renderListings(json.data);
            } else {
              renderListings([]);
            }
          })
          .catch(function() {
            if (grid) grid.innerHTML = '<p class="text-xs text-red-400 col-span-full">Unable to load listings. Please refresh.</p>';
          });
      }

      loadListings();
      window.addEventListener('rarivelle:listing-created', loadListings);
    })();
  </script>
</Layout>
