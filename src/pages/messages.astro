---
import Layout from '../layouts/Layout.astro';
import { API_URL } from '../lib/api';

export const prerender = true;
---

<Layout
  title="Private Messages | RARIVELLE"
  description="Confidential buyer-seller correspondence on RARIVELLE, routed through verified escrow protocol."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="border-b border-noir-800 pb-8 mb-10">
      <span class="text-[11px] uppercase tracking-[0.25em] text-gold-400 font-medium block mb-2">
        Confidential Correspondence
      </span>
      <h1 class="font-serif text-3xl sm:text-5xl text-ivory-100 font-light">
        Messages
      </h1>
      <p class="text-sm text-noir-400 mt-2 max-w-2xl font-light">
        Private buyer–seller dialogue on active salon listings. All correspondence is logged securely.
      </p>
    </div>

    <div id="messages-error" class="hidden text-center py-10 border border-red-500/30 bg-red-950/40 text-red-400 text-xs tracking-wide mb-6"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
      <!-- Conversation list -->
      <div id="conv-list-pane" class="lg:col-span-1 bg-noir-900/60 border border-noir-800">
        <div class="p-4 border-b border-noir-800 flex items-center justify-between">
          <span class="font-serif text-sm uppercase tracking-widest text-ivory-100">Conversations</span>
          <button id="conv-refresh-btn" type="button" class="text-[10px] uppercase tracking-widest text-gold-400 hover:text-gold-300 underline underline-offset-4 cursor-pointer">
            Refresh
          </button>
        </div>
        <div id="conv-list" class="divide-y divide-noir-800/60">
          <p class="text-xs text-noir-400 p-6 text-center">Loading conversations…</p>
        </div>
        <div id="conv-empty" class="hidden text-center py-12 px-6 space-y-4">
          <h3 class="font-serif text-lg text-ivory-200">No Conversations Yet</h3>
          <p class="text-xs text-noir-400 max-w-xs mx-auto">Browse the salon catalog and contact a seller to begin a private dialogue.</p>
          <a
            href="/discover"
            class="inline-block px-6 py-3 bg-gold-500 text-noir-950 text-xs uppercase tracking-wider font-semibold hover:bg-gold-400 transition-colors"
          >
            Explore the Salon
          </a>
        </div>
      </div>

      <!-- Chat panel -->
      <div id="chat-pane" class="hidden lg:block lg:col-span-2 bg-noir-900/60 border border-noir-800 flex-col min-h-[480px]">
        <div class="p-4 border-b border-noir-800 flex items-center gap-3">
          <button id="chat-back-btn" type="button" class="lg:hidden text-gold-400 hover:text-gold-300 text-xs uppercase tracking-widest cursor-pointer">
            &larr; Back
          </button>
          <div class="min-w-0">
            <div id="chat-counterpart" class="font-serif text-base text-ivory-100 truncate">Select a conversation</div>
            <div id="chat-product" class="text-[11px] text-noir-400 truncate"></div>
          </div>
        </div>
        <div id="chat-loading" class="hidden text-xs text-noir-400 p-6 text-center">Loading messages…</div>
        <div id="chat-messages" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-3 max-h-[420px] min-h-[300px]"></div>
        <div class="p-4 border-t border-noir-800">
          <div id="chat-error" class="hidden text-xs text-red-400 mb-2"></div>
          <form id="chat-form" class="flex gap-3">
            <input
              id="chat-input"
              type="text"
              maxlength="2000"
              autocomplete="off"
              placeholder="Write a confidential message…"
              class="flex-1 bg-noir-950 border border-noir-700 px-3.5 py-3 text-xs text-ivory-100 placeholder-noir-500 focus:outline-none focus:border-gold-500 transition-colors"
            />
            <button
              id="chat-send-btn"
              type="submit"
              class="px-6 py-3 bg-gold-500 hover:bg-gold-400 text-noir-950 text-xs uppercase tracking-widest font-semibold transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
            >
              Send
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ apiUrl: API_URL }}>
    (function() {
      // --- Login gate ---
      var rawUser = localStorage.getItem('rarivelle_user');
      var user = null;
      try { user = rawUser ? JSON.parse(rawUser) : null; } catch (e) {}
      if (!user || !user.userId) {
        window.location.href = '/login';
        return;
      }
      var userId = user.userId;

      var params = new URLSearchParams(window.location.search);
      var pendingConv = params.get('conv') || null;
      var pendingTo = params.get('to') || null;
      var pendingProduct = params.get('product') || null;

      var convListEl = document.getElementById('conv-list');
      var convEmptyEl = document.getElementById('conv-empty');
      var convPane = document.getElementById('conv-list-pane');
      var chatPane = document.getElementById('chat-pane');
      var chatMessagesEl = document.getElementById('chat-messages');
      var chatLoadingEl = document.getElementById('chat-loading');
      var chatCounterpartEl = document.getElementById('chat-counterpart');
      var chatProductEl = document.getElementById('chat-product');
      var chatForm = document.getElementById('chat-form');
      var chatInput = document.getElementById('chat-input');
      var chatSendBtn = document.getElementById('chat-send-btn');
      var chatErrorEl = document.getElementById('chat-error');
      var errorEl = document.getElementById('messages-error');

      var conversations = [];
      var openConvId = null;
      var openReceiverId = null;
      var openProductId = null;
      var pollTimer = null;

      function escapeHtml(s) {
        return String(s || '').replace(/[&<>"']/g, function(c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }

      function relativeTime(iso) {
        try {
          const diff = Date.now() - new Date(iso).getTime();
          if (isNaN(diff)) return '';
          const mins = Math.floor(diff / 60000);
          if (mins < 1) return 'just now';
          if (mins < 60) return mins + 'm ago';
          const hours = Math.floor(mins / 60);
          if (hours < 24) return hours + 'h ago';
          const days = Math.floor(hours / 24);
          if (days < 7) return days + 'd ago';
          return new Date(iso).toLocaleDateString();
        } catch (e) {
          return '';
        }
      }

      function showPageError(msg) {
        if (!errorEl) return;
        if (!msg) {
          errorEl.classList.add('hidden');
          return;
        }
        errorEl.textContent = msg;
        errorEl.classList.remove('hidden');
      }

      function notifyMessagesChanged() {
        window.dispatchEvent(new CustomEvent('rarivelle:messages-updated'));
      }

      async function loadConversations() {
        try {
          const res = await fetch(apiUrl + '?action=getConversations&userId=' + encodeURIComponent(userId));
          const json = await res.json();
          if (!json.success) throw new Error(json.error || 'Unable to load conversations.');
          conversations = Array.isArray(json.data) ? json.data : [];
          showPageError(null);
        } catch (err) {
          showPageError('Unable to load conversations. Please refresh the page.');
          conversations = [];
        }
        renderConvList();
        notifyMessagesChanged();
      }

      function renderConvList() {
        if (!convListEl) return;
        if (conversations.length === 0) {
          convListEl.innerHTML = '';
          if (convEmptyEl) convEmptyEl.classList.remove('hidden');
          return;
        }
        if (convEmptyEl) convEmptyEl.classList.add('hidden');
        convListEl.innerHTML = conversations.map(function(c) {
          const unread = c.unreadCount > 0
            ? '<span class="ml-2 inline-flex items-center justify-center min-w-[18px] h-[18px] px-1 rounded-full bg-gold-500 text-noir-950 text-[10px] font-bold">' + c.unreadCount + '</span>'
            : '';
          const active = c.conversationId === openConvId ? 'bg-gold-500/5 border-l-2 border-l-gold-500' : '';
          return [
            '<button type="button" data-conv-id="' + escapeHtml(c.conversationId) + '" class="conv-item w-full text-left p-4 hover:bg-noir-800/40 transition-colors cursor-pointer ' + active + '">',
              '<div class="flex items-center justify-between gap-2">',
                '<span class="font-serif text-sm text-ivory-100 truncate">' + escapeHtml(c.counterpartName) + '</span>' + unread,
              '</div>',
              '<div class="text-[11px] text-gold-400/80 uppercase tracking-widest truncate mt-0.5">' + escapeHtml(c.productTitle) + '</div>',
              '<div class="text-xs text-noir-400 truncate mt-1">' + escapeHtml(c.lastMessage) + '</div>',
              '<div class="text-[10px] text-noir-500 mt-1">' + escapeHtml(relativeTime(c.lastTimestamp)) + '</div>',
            '</button>'
          ].join('');
        }).join('');

        convListEl.querySelectorAll('[data-conv-id]').forEach(function(btn) {
          btn.addEventListener('click', function() {
            openConversation(btn.getAttribute('data-conv-id'));
          });
        });
      }

      function scrollChatToBottom() {
        if (chatMessagesEl) chatMessagesEl.scrollTop = chatMessagesEl.scrollHeight;
      }

      function renderMessages(messages) {
        if (!chatMessagesEl) return;
        if (messages.length === 0) {
          chatMessagesEl.innerHTML = '<p class="text-xs text-noir-400 text-center py-8">No messages yet. Write the first confidential note below.</p>';
          return;
        }
        chatMessagesEl.innerHTML = messages.map(function(m) {
          const mine = m.senderId === userId;
          const wrap = mine ? 'flex justify-end' : 'flex justify-start';
          const bubble = mine
            ? 'bg-gold-500/15 border-gold-500/40 text-ivory-100'
            : 'bg-noir-950 border-noir-800 text-ivory-200';
          return [
            '<div class="' + wrap + '">',
              '<div class="max-w-[80%] px-4 py-2.5 border ' + bubble + '">',
                '<p class="text-xs leading-relaxed whitespace-pre-wrap">' + escapeHtml(m.message) + '</p>',
                '<div class="text-[10px] text-noir-500 mt-1 text-right">' + escapeHtml(relativeTime(m.timestamp)) + '</div>',
              '</div>',
            '</div>'
          ].join('');
        }).join('');
        scrollChatToBottom();
      }

      function stopPolling() {
        if (pollTimer) {
          clearInterval(pollTimer);
          pollTimer = null;
        }
      }

      function startPolling() {
        stopPolling();
        // 15s polling, only while a conversation is open.
        pollTimer = setInterval(function() {
          if (openConvId) refreshOpenThread(true);
        }, 15000);
      }

      async function refreshOpenThread(silent) {
        if (!openConvId) return;
        try {
          const res = await fetch(apiUrl + '?action=getMessages&conversationId=' + encodeURIComponent(openConvId) + '&userId=' + encodeURIComponent(userId));
          const json = await res.json();
          if (json.success && Array.isArray(json.data)) {
            renderMessages(json.data);
            const hasUnreadInbound = json.data.some(function(m) {
              return m.receiverId === userId && !m.read;
            });
            if (hasUnreadInbound) {
              await fetch(apiUrl, {
                method: 'POST',
                body: JSON.stringify({ action: 'markRead', conversationId: openConvId, userId: userId })
              });
              loadConversations();
            }
          }
        } catch (e) {
          if (!silent && chatErrorEl) {
            chatErrorEl.textContent = 'Unable to refresh messages.';
            chatErrorEl.classList.remove('hidden');
          }
        }
      }

      async function openConversation(convId) {
        const conv = conversations.find(function(c) { return c.conversationId === convId; });
        openConvId = convId;
        openReceiverId = null;
        openProductId = null;

        if (conv) {
          const parts = convId.split('|');
          openProductId = conv.productId || parts[0];
          openReceiverId = conv.counterpartId;
          if (chatCounterpartEl) chatCounterpartEl.textContent = conv.counterpartName;
          if (chatProductEl) chatProductEl.textContent = conv.productTitle;
        }

        // Mobile: show chat pane
        if (chatPane) {
          chatPane.classList.remove('hidden');
          chatPane.classList.add('flex');
        }
        if (window.innerWidth < 1024 && convPane) convPane.classList.add('hidden');

        if (chatLoadingEl) chatLoadingEl.classList.remove('hidden');
        if (chatErrorEl) chatErrorEl.classList.add('hidden');
        renderConvList();
        await refreshOpenThread(false);
        if (chatLoadingEl) chatLoadingEl.classList.add('hidden');
        startPolling();
      }

      function closeConversation() {
        openConvId = null;
        openReceiverId = null;
        openProductId = null;
        stopPolling();
        if (chatPane) {
          chatPane.classList.add('hidden');
          chatPane.classList.remove('flex');
        }
        if (convPane) convPane.classList.remove('hidden');
        renderConvList();
      }

      async function resolveNewThreadContext() {
        // Returns { receiverId, productId, counterpartName, productTitle } for a fresh thread.
        let receiverId = pendingTo;
        let productId = pendingProduct;
        let counterpartName = 'New conversation';
        let productTitle = '';
        if (receiverId && receiverId !== 'rarivelle-house') {
          try {
            const res = await fetch(apiUrl + '?action=getSellerProfile&userId=' + encodeURIComponent(receiverId));
            const json = await res.json();
            if (json.success && json.data) counterpartName = json.data.name || counterpartName;
          } catch (e) {}
        }
        if (productId) {
          try {
            const res = await fetch(apiUrl + '?action=getProduct&productId=' + encodeURIComponent(productId));
            const json = await res.json();
            if (json.success && json.data) productTitle = json.data.title || '';
          } catch (e) {}
        }
        return { receiverId: receiverId, productId: productId, counterpartName: counterpartName, productTitle: productTitle };
      }

      if (chatForm) {
        chatForm.addEventListener('submit', async function(e) {
          e.preventDefault();
          const text = chatInput ? chatInput.value.trim() : '';
          if (!text) return;
          if (chatErrorEl) chatErrorEl.classList.add('hidden');

          // Determine receiver/product: open thread or pending new thread.
          let receiverId = openReceiverId;
          let productId = openProductId;
          if (!openConvId) {
            if (!pendingTo || !pendingProduct || pendingTo === 'rarivelle-house') return;
            receiverId = pendingTo;
            productId = pendingProduct;
          }
          if (!receiverId || !productId) return;

          if (chatSendBtn) chatSendBtn.disabled = true;
          try {
            const res = await fetch(apiUrl, {
              method: 'POST',
              body: JSON.stringify({ action: 'sendMessage', senderId: userId, receiverId: receiverId, productId: productId, message: text })
            });
            const json = await res.json();
            if (!json.success) throw new Error(json.error || 'Unable to send message.');
            if (chatInput) chatInput.value = '';
            const convId = json.data.conversationId;
            pendingConv = convId;
            pendingTo = null;
            try {
              window.history.replaceState(null, '', '/messages?conv=' + encodeURIComponent(convId));
            } catch (err) {}
            await loadConversations();
            await openConversation(convId);
          } catch (err) {
            if (chatErrorEl) {
              chatErrorEl.textContent = err.message || 'Unable to send message.';
              chatErrorEl.classList.remove('hidden');
            }
          } finally {
            if (chatSendBtn) chatSendBtn.disabled = false;
          }
        });
      }

      const backBtn = document.getElementById('chat-back-btn');
      if (backBtn) backBtn.addEventListener('click', closeConversation);

      const refreshBtn = document.getElementById('conv-refresh-btn');
      if (refreshBtn) {
        refreshBtn.addEventListener('click', async function() {
          await loadConversations();
          if (openConvId) refreshOpenThread(false);
        });
      }

      document.addEventListener('pagehide', stopPolling);

      // Boot
      (async function init() {
        await loadConversations();
        if (pendingConv) {
          const exists = conversations.some(function(c) { return c.conversationId === pendingConv; });
          if (exists) {
            openConversation(pendingConv);
            return;
          }
          // Fresh thread from Contact Seller: show composer immediately.
          if (pendingTo && pendingProduct && pendingTo !== 'rarivelle-house') {
            const ctx = await resolveNewThreadContext();
            openReceiverId = ctx.receiverId;
            openProductId = ctx.productId;
            if (chatCounterpartEl) chatCounterpartEl.textContent = ctx.counterpartName;
            if (chatProductEl) chatProductEl.textContent = ctx.productTitle;
            if (chatMessagesEl) chatMessagesEl.innerHTML = '<p class="text-xs text-noir-400 text-center py-8">No messages yet. Write the first confidential note below.</p>';
            if (chatPane) {
              chatPane.classList.remove('hidden');
              chatPane.classList.add('flex');
            }
            if (window.innerWidth < 1024 && convPane) convPane.classList.add('hidden');
          }
        }
      })();
    })();
  </script>
</Layout>
