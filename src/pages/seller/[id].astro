---
import Layout from '../../layouts/Layout.astro';
import { API_URL } from '../../lib/api';

export async function getStaticPaths() {
  // Seller IDs are only known at runtime — page renders client-side.
  return [];
}

const { id } = Astro.params;
---

<Layout
  title="Seller Profile | RARIVELLE"
  description="View a verified RARIVELLE seller's public profile and active salon listings."
>
  <div id="seller-container" data-seller-id={id} class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs uppercase tracking-wider text-noir-400 mb-8">
      <a href="/" class="hover:text-gold-400 transition-colors">Salon</a>
      <span>/</span>
      <a href="/discover" class="hover:text-gold-400 transition-colors">Marketplace</a>
      <span>/</span>
      <span class="text-gold-400/80">Seller</span>
    </nav>

    <!-- Loading -->
    <div id="seller-loading" class="text-center py-20">
      <p class="text-xs text-noir-400 tracking-widest uppercase">Loading seller profile…</p>
    </div>

    <!-- Error / Not found -->
    <div id="seller-error" class="hidden text-center py-20 border border-noir-800 bg-noir-900/30 p-8 max-w-2xl mx-auto space-y-4">
      <h3 id="seller-error-title" class="font-serif text-2xl text-ivory-100 font-light">Seller not found</h3>
      <p id="seller-error-msg" class="text-xs text-noir-400 max-w-md mx-auto">This seller profile does not exist or is unavailable.</p>
      <div>
        <a
          href="/discover"
          class="inline-block px-8 py-3.5 bg-gold-500 hover:bg-gold-400 text-noir-950 text-xs uppercase tracking-[0.2em] font-semibold transition-all"
        >
          Explore the Salon Catalog
        </a>
      </div>
    </div>

    <!-- Profile content -->
    <div id="seller-profile" class="hidden">
      <!-- Seller Header Banner -->
      <div class="bg-noir-900 border border-noir-800 p-8 sm:p-10 mb-12 relative overflow-hidden">
        <div class="absolute -right-16 -top-16 w-64 h-64 bg-gold-500/5 rounded-full blur-2xl pointer-events-none"></div>

        <div class="flex flex-col md:flex-row items-start md:items-center gap-8">
          <div class="relative shrink-0">
            <img
              id="seller-avatar-img"
              src=""
              alt="Seller"
              class="hidden w-20 h-20 sm:w-24 sm:h-24 rounded-full object-cover border-2 border-gold-500/50 shadow-xl"
            />
            <span
              id="seller-avatar-initial"
              class="w-20 h-20 sm:w-24 sm:h-24 rounded-full object-cover border-2 border-gold-500/50 shadow-xl items-center justify-center font-serif text-3xl text-gold-300 bg-gold-500/10 hidden"
            ></span>
            <span id="seller-verified-badge" class="hidden absolute bottom-1 right-1 w-5 h-5 bg-gold-500 text-noir-950 rounded-full items-center justify-center text-[10px] font-bold" title="Verified Seller">
              ✓
            </span>
          </div>

          <div class="space-y-1.5 flex-1 min-w-0">
            <span class="text-[10px] uppercase tracking-[0.25em] text-gold-400 font-semibold block mb-1">Verified Seller</span>
            <h1 id="seller-name" class="font-serif text-2xl sm:text-3xl text-ivory-100 font-light">Seller</h1>
            <p class="text-xs text-noir-400">
              <span id="seller-location">Private Vault</span>
              <span class="mx-2 text-noir-700">·</span>
              <span>Member since <span id="seller-since">—</span></span>
              <span class="mx-2 text-noir-700">·</span>
              <span class="text-gold-400 font-medium">★ <span id="seller-rating">5.0</span></span>
            </p>
            <p id="seller-bio" class="hidden text-xs text-ivory-300/80 leading-relaxed font-light pt-2 max-w-2xl"></p>
          </div>
        </div>

        <!-- Stats Strip -->
        <div class="mt-8 pt-8 border-t border-noir-800/80 grid grid-cols-2 gap-6">
          <div>
            <span class="block text-[10px] uppercase tracking-widest text-noir-400">Active Listings</span>
            <span id="seller-listings-count" class="font-serif text-2xl text-ivory-100 font-light">0</span>
          </div>
          <div>
            <span class="block text-[10px] uppercase tracking-widest text-noir-400">Salon Valuation</span>
            <span id="seller-valuation" class="font-serif text-2xl text-gold-300 font-light">$0</span>
          </div>
        </div>
      </div>

      <!-- Active Listings -->
      <div class="space-y-6">
        <div class="pb-4 border-b border-noir-800">
          <span class="text-[10px] uppercase tracking-[0.25em] text-gold-400 font-semibold block mb-1">Salon Portfolio</span>
          <h2 class="font-serif text-2xl text-ivory-100 font-light">Active Listings</h2>
        </div>

        <div id="seller-listings-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"></div>

        <div id="seller-no-listings" class="hidden text-center py-16 border border-dashed border-noir-800 bg-noir-900/30 p-8">
          <h3 class="font-serif text-lg text-ivory-200 mb-1">No Active Pieces Currently</h3>
          <p class="text-xs text-noir-400 max-w-sm mx-auto">This seller has no pieces listed in the salon right now.</p>
        </div>
      </div>
    </div>

  </div>

  <script is:inline define:vars={{ apiUrl: API_URL }}>
    (function() {
      const container = document.getElementById('seller-container');
      const sellerId = container ? container.getAttribute('data-seller-id') : null;

      const loadingEl = document.getElementById('seller-loading');
      const errorEl = document.getElementById('seller-error');
      const errorTitle = document.getElementById('seller-error-title');
      const errorMsg = document.getElementById('seller-error-msg');
      const profileEl = document.getElementById('seller-profile');

      function formatUSD(amount) {
        return new Intl.NumberFormat('en-US', {
          style: 'currency',
          currency: 'USD',
          maximumFractionDigits: 0
        }).format(amount);
      }

      function escapeHtml(s) {
        return String(s || '').replace(/[&<>"']/g, function(c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }

      const FALLBACK_IMG = 'https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=1200&auto=format&fit=crop';

      function safeImageUrl(u) {
        const s = String(u || '').trim();
        return /^https?:\/\/.+/i.test(s) ? s : FALLBACK_IMG;
      }

      function showError(title, msg) {
        if (loadingEl) loadingEl.classList.add('hidden');
        if (profileEl) profileEl.classList.add('hidden');
        if (errorTitle) errorTitle.textContent = title;
        if (errorMsg) errorMsg.textContent = msg;
        if (errorEl) errorEl.classList.remove('hidden');
      }

      if (!sellerId) {
        showError('Seller not found', 'This seller profile does not exist or is unavailable.');
        return;
      }

      fetch(apiUrl + '?action=getSellerProfile&userId=' + encodeURIComponent(sellerId))
        .then(function(res) { return res.json(); })
        .then(function(json) {
          if (!json.success || !json.data) {
            showError('Seller not found', 'This seller profile does not exist or is unavailable.');
            return;
          }
          renderProfile(json.data);
        })
        .catch(function() {
          showError('Unable to load profile', 'The salon archive could not be reached. Please refresh the page.');
        });

      function renderProfile(p) {
        if (loadingEl) loadingEl.classList.add('hidden');
        if (errorEl) errorEl.classList.add('hidden');
        if (profileEl) profileEl.classList.remove('hidden');
        document.title = (p.name || 'Seller') + ' | RARIVELLE';

        const nameEl = document.getElementById('seller-name');
        if (nameEl) nameEl.textContent = p.name || 'Private Collector';

        // Avatar: photo when set, neutral initial tile otherwise.
        const imgEl = document.getElementById('seller-avatar-img');
        const initialEl = document.getElementById('seller-avatar-initial');
        const firstLetter = (p.name || 'R').trim().charAt(0).toUpperCase() || 'R';
        if (p.avatarUrl && /^https?:\/\/.+/i.test(String(p.avatarUrl).trim())) {
          if (imgEl) {
            imgEl.src = String(p.avatarUrl).trim();
            imgEl.alt = p.name || 'Seller';
            imgEl.classList.remove('hidden');
          }
          if (initialEl) {
            initialEl.classList.add('hidden');
            initialEl.classList.remove('flex');
          }
        } else {
          if (imgEl) imgEl.classList.add('hidden');
          if (initialEl) {
            initialEl.textContent = firstLetter;
            initialEl.classList.remove('hidden');
            initialEl.classList.add('flex');
          }
        }

        const badgeEl = document.getElementById('seller-verified-badge');
        if (badgeEl) {
          badgeEl.classList.remove('hidden');
          badgeEl.classList.add('flex');
        }

        const locEl = document.getElementById('seller-location');
        if (locEl) locEl.textContent = p.location || 'Private Vault';

        const sinceEl = document.getElementById('seller-since');
        if (sinceEl) sinceEl.textContent = p.memberSince || '—';

        const ratingEl = document.getElementById('seller-rating');
        if (ratingEl) ratingEl.textContent = p.rating || '5.0';

        // Bio hidden when empty.
        const bioEl = document.getElementById('seller-bio');
        if (bioEl) {
          if (p.bio) {
            bioEl.textContent = p.bio;
            bioEl.classList.remove('hidden');
          } else {
            bioEl.classList.add('hidden');
          }
        }

        const countEl = document.getElementById('seller-listings-count');
        if (countEl) countEl.textContent = String((p.stats && p.stats.activeListings) || 0);

        const valEl = document.getElementById('seller-valuation');
        if (valEl) valEl.textContent = formatUSD((p.stats && p.stats.totalValuation) || 0);

        const grid = document.getElementById('seller-listings-grid');
        const emptyState = document.getElementById('seller-no-listings');
        const listings = p.listings || [];

        if (listings.length === 0) {
          if (grid) grid.innerHTML = '';
          if (emptyState) emptyState.classList.remove('hidden');
          return;
        }
        if (emptyState) emptyState.classList.add('hidden');

        if (grid) {
          grid.innerHTML = listings.map(function(item) {
            const img = safeImageUrl(item.images && item.images[0]);
            const itemHref = '/product/' + encodeURIComponent(item.productId);
            return [
              '<div class="bg-noir-900 border border-noir-800 hover:border-gold-500/50 transition-all flex flex-col justify-between overflow-hidden">',
                '<div class="relative aspect-4/3 w-full bg-noir-950 overflow-hidden">',
                  '<a href="' + itemHref + '" class="block w-full h-full">',
                    '<img src="' + img + '" alt="' + escapeHtml(item.title) + '" class="w-full h-full object-cover" />',
                  '</a>',
                  '<span class="absolute top-3 left-3 px-2 py-0.5 text-[9px] uppercase tracking-widest bg-emerald-950/80 text-emerald-400 border border-emerald-500/30 font-semibold backdrop-blur-sm">Active in Salon</span>',
                '</div>',
                '<div class="p-5 flex flex-col flex-1 justify-between space-y-4">',
                  '<div>',
                    '<div class="text-[10px] text-gold-400 uppercase tracking-widest mb-1">' + escapeHtml(item.category) + ' · Circa ' + escapeHtml(item.year || 'Historic') + '</div>',
                    '<h3 class="font-serif text-base text-ivory-100 line-clamp-2"><a href="' + itemHref + '">' + escapeHtml(item.title) + '</a></h3>',
                    '<div class="text-xs text-noir-400 mt-1">Vault: ' + escapeHtml(item.location || 'Private Custody') + '</div>',
                  '</div>',
                  '<div class="pt-4 border-t border-noir-800 flex items-center justify-between">',
                    '<div>',
                      '<span class="block text-[9px] uppercase tracking-widest text-noir-400">Listed Price</span>',
                      '<span class="font-serif text-lg text-gold-300 font-light">' + formatUSD(item.price) + '</span>',
                    '</div>',
                    '<a href="' + itemHref + '" class="px-3 py-1 bg-noir-950 border border-gold-500/40 text-gold-300 hover:bg-gold-500 hover:text-noir-950 text-[10px] uppercase tracking-widest font-semibold transition-colors">View Dossier &rarr;</a>',
                  '</div>',
                '</div>',
              '</div>'
            ].join('');
          }).join('');
        }
      }
    })();
  </script>
</Layout>
