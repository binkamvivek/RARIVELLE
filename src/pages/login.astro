---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Sign In | RARIVELLE"
  description="Sign in to your RARIVELLE collector account to manage your vault, wishlist, and consignments."
>
  <div class="min-h-[80vh] flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-md">

      <!-- Header -->
      <div class="text-center mb-10">
        <p class="text-[10px] uppercase tracking-[0.3em] text-gold-400 font-semibold mb-3">Collector Access</p>
        <h1 class="font-serif text-3xl sm:text-4xl text-ivory-100 font-light mb-2">Sign In</h1>
        <p class="text-xs text-noir-400 tracking-wide">Access your vault and private collection</p>
      </div>

      <!-- Card -->
      <div class="bg-noir-900 border border-noir-800 p-8 sm:p-10 relative overflow-hidden">
        <!-- Decorative glow -->
        <div class="absolute -right-12 -top-12 w-40 h-40 bg-gold-500/5 rounded-full blur-2xl pointer-events-none"></div>

        <!-- Error Message -->
        <div
          id="login-error"
          class="hidden mb-6 px-4 py-3 border border-red-500/30 bg-red-950/40 text-red-400 text-xs tracking-wide"
          role="alert"
        ></div>

        <!-- Form -->
        <form id="login-form" class="space-y-6" novalidate>

          <!-- Email -->
          <div class="space-y-1.5">
            <label for="login-email" class="block text-[10px] uppercase tracking-[0.2em] text-ivory-300/70 font-semibold">
              Email Address
            </label>
            <input
              id="login-email"
              type="email"
              name="email"
              autocomplete="email"
              required
              placeholder="collector@example.com"
              class="w-full bg-noir-950 border border-noir-700 text-ivory-100 text-sm px-4 py-3 placeholder:text-noir-500 focus:outline-none focus:border-gold-500/60 transition-colors duration-200"
            />
          </div>

          <!-- Password -->
          <div class="space-y-1.5">
            <label for="login-password" class="block text-[10px] uppercase tracking-[0.2em] text-ivory-300/70 font-semibold">
              Password
            </label>
            <input
              id="login-password"
              type="password"
              name="password"
              autocomplete="current-password"
              required
              placeholder="••••••••"
              class="w-full bg-noir-950 border border-noir-700 text-ivory-100 text-sm px-4 py-3 placeholder:text-noir-500 focus:outline-none focus:border-gold-500/60 transition-colors duration-200"
            />
          </div>

          <!-- Submit -->
          <button
            id="login-btn"
            type="submit"
            class="w-full flex items-center justify-center gap-2 px-6 py-3.5 bg-gold-500 hover:bg-gold-400 text-noir-950 text-xs uppercase tracking-[0.2em] font-semibold transition-all duration-200 disabled:opacity-60 disabled:cursor-not-allowed"
          >
            <span id="login-btn-text">Sign In</span>
            <svg
              id="login-spinner"
              class="hidden w-4 h-4 animate-spin"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
          </button>

        </form>

        <!-- Divider -->
        <div class="mt-8 pt-6 border-t border-noir-800 text-center">
          <p class="text-xs text-noir-500 tracking-wide">
            New to RARIVELLE?
            <a href="/signup" class="text-gold-400 hover:text-gold-300 underline underline-offset-4 transition-colors ml-1">
              Create an Account
            </a>
          </p>
        </div>
      </div>

    </div>
  </div>
</Layout>

<script>
  import { API_URL, setCurrentUser } from '../lib/api.ts';

  const form = document.getElementById('login-form') as HTMLFormElement;
  const btn = document.getElementById('login-btn') as HTMLButtonElement;
  const btnText = document.getElementById('login-btn-text')!;
  const spinner = document.getElementById('login-spinner')!;
  const errorEl = document.getElementById('login-error')!;

  function setLoading(loading: boolean) {
    btn.disabled = loading;
    btnText.textContent = loading ? 'Signing In…' : 'Sign In';
    spinner.classList.toggle('hidden', !loading);
  }

  function showError(msg: string) {
    errorEl.textContent = msg;
    errorEl.classList.remove('hidden');
  }

  function hideError() {
    errorEl.classList.add('hidden');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();

    const email = (document.getElementById('login-email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('login-password') as HTMLInputElement).value.trim();

    if (!email || !password) {
      showError('Please enter your email and password.');
      return;
    }

    setLoading(true);
    try {
      const res = await fetch(API_URL, {
        method: 'POST',
        body: JSON.stringify({ action: 'login', email, password }),
      });
      const json = await res.json();

      if (json.success && json.data) {
        setCurrentUser(json.data);
        window.dispatchEvent(new CustomEvent('rarivelle:auth-updated'));
        window.location.href = '/account';
      } else {
        showError(json.error || 'Invalid email or password.');
      }
    } catch {
      showError('Unable to reach the server. Please try again.');
    } finally {
      setLoading(false);
    }
  });
</script>
