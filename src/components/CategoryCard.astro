---
interface Props {
  id: string;
  name: string;
  description: string;
  image: string;
  count: number;
}

const { id, name, description, image, count } = Astro.props;
---

<a 
  href={`/discover?category=${encodeURIComponent(name)}`} 
  class="group relative block overflow-hidden bg-noir-900 border border-noir-800 hover:border-gold-500/50 transition-all duration-300 aspect-3/4 sm:aspect-4/5"
>
  <!-- Background Image with Zoom -->
  <img 
    src={image} 
    alt={name} 
    loading="lazy"
    class="w-full h-full object-cover object-center brightness-75 group-hover:brightness-95 group-hover:scale-105 transition-all duration-700 ease-out"
  />

  <!-- Subtle Vignette & Scrim -->
  <div class="absolute inset-0 bg-gradient-to-t from-noir-950 via-noir-950/40 to-transparent"></div>

  <!-- Content Overlay -->
  <div class="absolute inset-0 p-6 flex flex-col justify-between">
    <div class="flex justify-between items-center">
      <span class="text-[10px] uppercase tracking-widest px-2 py-0.5 border border-white/20 bg-noir-950/60 backdrop-blur-sm text-gold-300">
        {count} Pieces
      </span>
      <span class="text-gold-400 opacity-0 group-hover:opacity-100 transition-opacity duration-300 text-sm">
        &rarr;
      </span>
    </div>

    <div>
      <h3 class="font-serif text-xl sm:text-2xl text-ivory-100 group-hover:text-gold-300 transition-colors duration-200">
        {name}
      </h3>
      <p class="text-xs text-ivory-300/70 mt-1 line-clamp-2 leading-relaxed font-light">
        {description}
      </p>
      <div class="mt-3 inline-flex items-center text-[10px] uppercase tracking-widest text-gold-400/90 font-medium group-hover:text-gold-300">
        Browse Collection &rarr;
      </div>
    </div>
  </div>
</a>
