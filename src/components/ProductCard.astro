---
import type { Collectible } from '../data/collectibles';
import { formatCurrency } from '../utils/store';

interface Props {
  item: Collectible;
  priority?: boolean;
}

const { item, priority = false } = Astro.props;
const formattedPrice = formatCurrency(item.price);
---

<div class="group relative flex flex-col bg-noir-900/60 border border-noir-800 hover:border-gold-500/50 transition-all duration-300 overflow-hidden">
  <!-- Image Container -->
  <div class="relative aspect-4/3 sm:aspect-square w-full overflow-hidden bg-noir-950">
    <a href={`/product/${item.id}`} class="block w-full h-full">
      <img 
        src={item.images[0]} 
        alt={item.title} 
        loading={priority ? 'eager' : 'lazy'}
        class="w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-700 ease-out brightness-90 group-hover:brightness-100"
      />
    </a>

    <!-- Top Floating Badges -->
    <div class="absolute top-3 left-3 flex flex-col gap-1.5 pointer-events-none">
      <span class="inline-block px-2.5 py-1 text-[10px] uppercase tracking-widest font-semibold bg-noir-950/80 text-gold-300 border border-gold-500/30 backdrop-blur-md">
        {item.condition}
      </span>
      {item.rareFind && (
        <span class="inline-block px-2 py-0.5 text-[9px] uppercase tracking-widest font-medium bg-gold-500 text-noir-950">
          Rare Find
        </span>
      )}
    </div>

    <!-- Wishlist Button -->
    <button 
      type="button"
      data-wishlist-btn={item.id}
      data-item-title={item.title}
      aria-label="Save to Wishlist"
      class="wishlist-btn absolute top-3 right-3 p-2.5 rounded-full bg-noir-950/70 hover:bg-noir-950 text-ivory-300 hover:text-gold-400 border border-white/10 hover:border-gold-500/50 backdrop-blur-md transition-all duration-200 cursor-pointer z-10"
    >
      <svg class="w-4 h-4 heart-icon transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
      </svg>
    </button>
  </div>

  <!-- Content Info -->
  <div class="p-5 flex flex-col flex-1 justify-between bg-gradient-to-b from-noir-900/40 to-noir-900/90">
    <div>
      <div class="flex items-center justify-between text-[11px] text-gold-400/80 uppercase tracking-widest mb-1.5">
        <span>{item.category}</span>
        <span>{item.year}</span>
      </div>

      <h3 class="font-serif text-base font-normal text-ivory-100 group-hover:text-gold-300 transition-colors duration-200 line-clamp-2 leading-snug">
        <a href={`/product/${item.id}`}>
          {item.title}
        </a>
      </h3>

      <div class="mt-2.5 flex items-center gap-1.5 text-xs text-noir-400">
        <svg class="w-3.5 h-3.5 text-noir-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span class="truncate">{item.location}</span>
      </div>
    </div>

    <div class="mt-5 pt-4 border-t border-noir-800/80 flex items-center justify-between">
      <div>
        <span class="block text-[9px] uppercase tracking-widest text-noir-400">Valuation</span>
        <span class="font-serif text-lg text-gold-300 font-light tracking-wide">{formattedPrice}</span>
      </div>

      <!-- Seller Mini Badge -->
      <div class="text-right">
        <span class="block text-[9px] uppercase tracking-widest text-noir-400">Custodian</span>
        <div class="flex items-center gap-1 text-xs text-ivory-300/90 font-medium">
          <span class="truncate max-w-[120px]">{item.seller.name}</span>
          {item.seller.verified && (
            <svg class="w-3.5 h-3.5 text-gold-400 shrink-0" fill="currentColor" viewBox="0 0 20 20" title="Verified Custodian">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          )}
        </div>
      </div>
    </div>
  </div>
</div>
