---
import Layout from '../layouts/Layout.astro';
import { CATEGORIES } from '../data/collectibles';
import { API_URL } from '../lib/api';

export const prerender = true;
---

<Layout 
  title="Consign or List an Item | RARIVELLE"
  description="Present your rare collectible to verified patrons and connoisseurs. Zero upfront listing fees with institutional escrow protection."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="border-b border-noir-800 pb-8 mb-10 text-center max-w-3xl mx-auto">
      <span class="text-[11px] uppercase tracking-[0.3em] text-gold-400 font-semibold block mb-2">
        Consignment & Salon Listing
      </span>
      <h1 class="font-serif text-3xl sm:text-5xl text-ivory-100 font-light">
        List a Masterpiece
      </h1>
      <p class="text-sm text-noir-400 mt-3 font-light leading-relaxed">
        Present your exceptional artifact or collectible to our global network of verified collectors and institutions. Complete the details below to generate your private listing.
      </p>
    </div>

    <!-- Split Screen: Left = Form, Right = Live Preview -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left: Listing Form (7 cols) -->
      <div class="lg:col-span-7 bg-noir-900/60 border border-noir-800 p-6 sm:p-8 space-y-8">
        <form id="sell-form" class="space-y-6">
          
          <!-- Image Upload Section -->
          <div>
            <label class="block text-xs uppercase tracking-wider text-ivory-200 font-medium mb-1.5">
              Photography & Archive Plates *
            </label>
            <p class="text-[11px] text-noir-400 mb-3">
              Paste direct image URLs (https) showing hallmarks, condition, and full profiles — one per line.
            </p>

            <!-- Image URLs -->
            <textarea
              id="image-urls-input"
              rows="3"
              placeholder="https://example.com/photo-1.jpg&#10;https://example.com/photo-2.jpg"
              class="w-full bg-noir-950 border border-noir-700 p-3.5 text-xs text-ivory-100 placeholder-noir-500 focus:outline-none focus:border-gold-500 transition-colors leading-relaxed"
            ></textarea>

            <!-- Quick sample photos button for instant luxury testing -->
            <div class="mt-2.5 flex items-center justify-between text-xs">
              <span class="text-[11px] text-noir-400">Need instant sample luxury photos?</span>
              <button 
                type="button" 
                id="load-sample-imgs-btn" 
                class="text-[10px] uppercase tracking-wider text-gold-400 hover:text-gold-300 underline underline-offset-4 cursor-pointer"
              >
                Insert Sample Photos
              </button>
            </div>

            <!-- Uploaded Thumbnails Preview Grid -->
            <div id="uploaded-thumbnails" class="grid grid-cols-4 gap-3 mt-4"></div>
          </div>

          <!-- Title -->
          <div>
            <label for="form-title" class="block text-xs uppercase tracking-wider text-ivory-200 font-medium mb-1.5">
              Title of Piece *
            </label>
            <input 
              type="text" 
              id="form-title" 
              required 
              placeholder="e.g. Vacheron Constantin 222 in 18k Yellow Gold" 
              class="w-full bg-noir-950 border border-noir-700 px-3.5 py-3 text-xs text-ivory-100 placeholder-noir-500 focus:outline-none focus:border-gold-500 transition-colors"
            />
          </div>

          <!-- Category & Brand -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="form-category" class="block text-xs uppercase tracking-wider text-ivory-200 font-medium mb-1.5">
                Department / Category *
              </label>
              <select 
                id="form-category" 
                required 
                class="w-full bg-noir-950 border border-noir-700 px-3 py-3 text-xs text-ivory-100 focus:outline-none focus:border-gold-500 transition-colors cursor-pointer"
              >
                {CATEGORIES.map(cat => (
                  <option value={cat.name}>{cat.name}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="form-brand" class="block text-xs uppercase tracking-wider text-ivory-200 font-medium mb-1.5">
                Brand / Maker / Artisan *
              </label>
              <input 
                type="text" 
                id="form-brand" 
                required 
                placeholder="e.g. Vacheron Constantin / Tiffany & Co." 
                class="w-full bg-noir-950 border border-noir-700 px-3.5 py-3 text-xs text-ivory-100 placeholder-noir-500 focus:outline-none focus:border-gold-500 transition-colors"
              />
            </div>
          </div>

          <!-- Valuation & Year -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="form-price" class="block text-xs uppercase tracking-wider text-ivory-200 font-medium mb-1.5">
                Curated Valuation (USD) *
              </label>
              <div class="relative">
                <span class="absolute left-3.5 top-3 text-xs text-noir-400 font-serif">$</span>
                <input 
                  type="number" 
                  id="form-price" 
                  required 
                  min="500" 
                  step="500" 
                  placeholder="85000" 
                  class="w-full bg-noir-950 border border-noir-700 pl-8 pr-3.5 py-3 text-xs text-ivory-100 placeholder-noir-500 focus:outline-none focus:border-gold-500 transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="form-year" class="block text-xs uppercase tracking-wider text-ivory-200 font-medium mb-1.5">
                Year of Origin / Era *
              </label>
              <input 
                type="text" 
                id="form-year" 
                required 
                placeholder="e.g. 1977 or 18th Century" 
                class="w-full bg-noir-950 border border-noir-700 px-3.5 py-3 text-xs text-ivory-100 placeholder-noir-500 focus:outline-none focus:border-gold-500 transition-colors"
              />
            </div>
          </div>

          <!-- Condition & Location -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="form-condition" class="block text-xs uppercase tracking-wider text-ivory-200 font-medium mb-1.5">
                Condition Grade *
              </label>
              <select 
                id="form-condition" 
                required 
                class="w-full bg-noir-950 border border-noir-700 px-3 py-3 text-xs text-ivory-100 focus:outline-none focus:border-gold-500 transition-colors cursor-pointer"
              >
                <option value="Museum Grade">Museum Grade (Flawless preservation)</option>
                <option value="Near Mint">Near Mint (Exceptional with box/papers)</option>
                <option value="Excellent">Excellent (Minor sympathetic patina)</option>
                <option value="Restored Historic">Restored Historic (Conservation completed)</option>
              </select>
            </div>

            <div>
              <label for="form-location" class="block text-xs uppercase tracking-wider text-ivory-200 font-medium mb-1.5">
                Current Vault Location *
              </label>
              <input 
                type="text" 
                id="form-location" 
                required 
                placeholder="e.g. Zurich, Switzerland" 
                class="w-full bg-noir-950 border border-noir-700 px-3.5 py-3 text-xs text-ivory-100 placeholder-noir-500 focus:outline-none focus:border-gold-500 transition-colors"
              />
            </div>
          </div>

          <!-- Description -->
          <div>
            <label for="form-description" class="block text-xs uppercase tracking-wider text-ivory-200 font-medium mb-1.5">
              Historical Narrative & Description *
            </label>
            <textarea 
              id="form-description" 
              rows="4" 
              required 
              placeholder="Describe the craftsmanship, historical importance, mechanical details, and any notable ownership history..." 
              class="w-full bg-noir-950 border border-noir-700 p-3.5 text-xs text-ivory-100 placeholder-noir-500 focus:outline-none focus:border-gold-500 transition-colors leading-relaxed"
            ></textarea>
          </div>

          <!-- Provenance -->
          <div>
            <label for="form-provenance" class="block text-xs uppercase tracking-wider text-ivory-200 font-medium mb-1.5">
              Custodial Provenance (Optional)
            </label>
            <input 
              type="text" 
              id="form-provenance" 
              placeholder="e.g. Acquired from Sotheby's Geneva (1998); private French family estate." 
              class="w-full bg-noir-950 border border-noir-700 px-3.5 py-3 text-xs text-ivory-100 placeholder-noir-500 focus:outline-none focus:border-gold-500 transition-colors"
            />
          </div>

          <!-- Submit Button -->
          <div class="pt-4">
            <button 
              type="submit" 
              id="publish-btn"
              class="w-full py-4 bg-gold-500 hover:bg-gold-400 text-noir-950 text-xs uppercase tracking-[0.25em] font-bold text-center transition-all duration-300 shadow-xl cursor-pointer"
            >
              Publish Listing to Salon
            </button>
            <p class="text-[11px] text-center text-noir-400 mt-2.5">
              By publishing, you agree to RARIVELLE's authentic provenance standards and escrow verification protocols.
            </p>
          </div>

        </form>
      </div>

      <!-- Right: Live Listing Preview (5 cols) -->
      <div class="lg:col-span-5 sticky top-28 space-y-4">
        <div class="flex items-center justify-between pb-2 border-b border-noir-800">
          <span class="text-[11px] uppercase tracking-[0.2em] text-gold-400 font-semibold">Live Listing Preview</span>
          <span class="text-[10px] text-noir-500 uppercase tracking-widest">Salon Display Card</span>
        </div>

        <!-- The Preview Card -->
        <div class="bg-noir-900 border border-gold-500/40 shadow-2xl overflow-hidden">
          <div class="relative aspect-square w-full bg-noir-950 overflow-hidden">
            <img 
              id="preview-image" 
              src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=1200&auto=format&fit=crop" 
              alt="Listing Preview" 
              class="w-full h-full object-cover object-center"
            />
            <div class="absolute top-3 left-3 flex flex-col gap-1.5 pointer-events-none">
              <span id="preview-condition-badge" class="inline-block px-2.5 py-1 text-[10px] uppercase tracking-widest font-semibold bg-noir-950/80 text-gold-300 border border-gold-500/30 backdrop-blur-md">
                Museum Grade
              </span>
              <span class="inline-block px-2 py-0.5 text-[9px] uppercase tracking-widest font-medium bg-gold-500 text-noir-950">
                New Listing
              </span>
            </div>
            <div class="absolute top-3 right-3 p-2.5 rounded-full bg-noir-950/70 text-gold-400 border border-gold-500/30">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
          </div>

          <div class="p-6 space-y-4">
            <div>
              <div class="flex items-center justify-between text-[11px] text-gold-400/80 uppercase tracking-widest mb-1.5">
                <span id="preview-category">Haute Horology</span>
                <span id="preview-year">1977</span>
              </div>
              <h3 id="preview-title" class="font-serif text-lg font-normal text-ivory-100 leading-snug line-clamp-2">
                Vacheron Constantin 222 in 18k Yellow Gold
              </h3>
              <div class="mt-2 flex items-center gap-1.5 text-xs text-noir-400">
                <svg class="w-3.5 h-3.5 text-noir-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span id="preview-location">Zurich, Switzerland</span>
              </div>
            </div>

            <p id="preview-desc" class="text-xs text-noir-400 font-light line-clamp-3 leading-relaxed border-t border-noir-800/80 pt-3">
              One of the defining sports-luxury silhouettes of the late 20th century. Fitted with original integrated bracelet and champagne dial.
            </p>

            <div class="pt-4 border-t border-noir-800/80 flex items-center justify-between">
              <div>
                <span class="block text-[9px] uppercase tracking-widest text-noir-400">Valuation</span>
                <span id="preview-price" class="font-serif text-xl text-gold-300 font-light">$85,000</span>
              </div>
              <div class="text-right">
                <span class="block text-[9px] uppercase tracking-widest text-noir-400">Custodian</span>
                <div class="flex items-center gap-1 text-xs text-ivory-300 font-medium">
                  <span>You (Verified Member)</span>
                  <svg class="w-3.5 h-3.5 text-gold-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Trust Info Box -->
        <div class="p-4 bg-noir-900/40 border border-noir-800 text-[11px] text-noir-400 space-y-1">
          <div class="text-gold-400 font-serif font-semibold uppercase tracking-wider">Provenance Verification Step</div>
          <p>Once published, your item will be cataloged on RARIVELLE. Interested patrons can place direct bids or request a physical viewing.</p>
        </div>
      </div>

    </div>
  </div>

  <!-- Client-side script for Image URLs, Live preview sync & Publishing (Phase 2B API) -->
  <script is:inline define:vars={{ apiUrl: API_URL }}>
    (function() {
      // --- Auth gate (Phase 2A session) ---
      let currentUser = null;
      try {
        const rawUser = localStorage.getItem('rarivelle_user');
        currentUser = rawUser ? JSON.parse(rawUser) : null;
      } catch (e) {}
      if (!currentUser || !currentUser.userId) {
        window.location.href = '/login';
        return;
      }

      // --- Edit mode (?edit=productId) ---
      const editId = new URLSearchParams(window.location.search).get('edit');

      // Sample fallback images (URLs only — never data-URL/base64)
      const samplePhotos = [
        'https://images.unsplash.com/photo-1548036328-c9fa89d128fa?q=80&w=1200&auto=format&fit=crop',
        'https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=1200&auto=format&fit=crop',
        'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?q=80&w=1200&auto=format&fit=crop',
      ];

      const urlsInput = document.getElementById('image-urls-input');
      const thumbsContainer = document.getElementById('uploaded-thumbnails');
      const sampleBtn = document.getElementById('load-sample-imgs-btn');

      function readUrlList() {
        const raw = urlsInput ? urlsInput.value : '';
        return raw.split(/[\n,]+/).map(function(s) { return s.trim(); }).filter(function(s) {
          return /^https?:\/\/.+/i.test(s);
        }).slice(0, 8);
      }

      function currentImages() {
        const urls = readUrlList();
        return urls.length > 0 ? urls : [];
      }

      // Splits a legacy trailing "\n\nProvenance: …" suffix (pre-column rows only).
      function splitLegacyProvenance(text) {
        const m = String(text || '').match(/^(.*?)(?:\r?\n\r?\nProvenance:\s*([\s\S]*))$/);
        if (!m) return { description: String(text || ''), provenance: '' };
        return { description: m[1].trimEnd(), provenance: (m[2] || '').trim() };
      }

      // Form inputs
      const titleInput = document.getElementById('form-title');
      const categoryInput = document.getElementById('form-category');
      const brandInput = document.getElementById('form-brand');
      const priceInput = document.getElementById('form-price');
      const yearInput = document.getElementById('form-year');
      const conditionInput = document.getElementById('form-condition');
      const locationInput = document.getElementById('form-location');
      const descInput = document.getElementById('form-description');
      const provenanceInput = document.getElementById('form-provenance');
      const form = document.getElementById('sell-form');

      // Preview elements
      const previewImg = document.getElementById('preview-image');
      const previewTitle = document.getElementById('preview-title');
      const previewCat = document.getElementById('preview-category');
      const previewYear = document.getElementById('preview-year');
      const previewPrice = document.getElementById('preview-price');
      const previewCond = document.getElementById('preview-condition-badge');
      const previewLoc = document.getElementById('preview-location');
      const previewDesc = document.getElementById('preview-desc');

      function formatUSD(val) {
        if (!val || isNaN(val)) return '$0';
        return new Intl.NumberFormat('en-US', {
          style: 'currency',
          currency: 'USD',
          maximumFractionDigits: 0
        }).format(val);
      }

      function updatePreview() {
        if (previewTitle && titleInput) {
          previewTitle.textContent = titleInput.value || 'Untitled Rare Collectible';
        }
        if (previewCat && categoryInput) {
          previewCat.textContent = categoryInput.value;
        }
        if (previewYear && yearInput) {
          previewYear.textContent = yearInput.value || 'Circa Modern';
        }
        if (previewPrice && priceInput) {
          previewPrice.textContent = formatUSD(Number(priceInput.value));
        }
        if (previewCond && conditionInput) {
          previewCond.textContent = conditionInput.value;
        }
        if (previewLoc && locationInput) {
          previewLoc.textContent = locationInput.value || 'Private Vault';
        }
        if (previewDesc && descInput) {
          previewDesc.textContent = descInput.value || 'Collector description will appear here as you type...';
        }
        const liveUrls = currentImages();
        if (previewImg && liveUrls.length > 0) {
          previewImg.src = liveUrls[0];
        }
      }

      function renderThumbnails() {
        if (!thumbsContainer) return;
        thumbsContainer.innerHTML = currentImages().map((src, idx) => `
          <div class="relative group aspect-square bg-noir-950 border border-noir-700 overflow-hidden">
            <img src="${src}" alt="Upload ${idx + 1}" class="w-full h-full object-cover" />
            <button
              type="button"
              data-remove-thumb="${idx}"
              class="absolute top-1 right-1 w-5 h-5 rounded-full bg-noir-950/80 text-white hover:text-red-400 flex items-center justify-center text-xs"
            >
              &times;
            </button>
          </div>
        `).join('');

        // Attach remove handler
        thumbsContainer.querySelectorAll('[data-remove-thumb]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const idx = Number(btn.getAttribute('data-remove-thumb'));
            const urls = currentImages();
            urls.splice(idx, 1);
            if (urlsInput) urlsInput.value = urls.join('\n');
            renderThumbnails();
            updatePreview();
          });
        });
      }

      // Image URL textarea -> live thumbs + preview
      if (urlsInput) {
        urlsInput.addEventListener('input', () => {
          renderThumbnails();
          updatePreview();
        });
      }

      // Sample images button (fills URL list)
      if (sampleBtn) {
        sampleBtn.addEventListener('click', () => {
          if (urlsInput) urlsInput.value = samplePhotos.join('\n');
          renderThumbnails();
          updatePreview();
        });
      }

      // Form input listeners for live preview
      [titleInput, categoryInput, brandInput, priceInput, yearInput, conditionInput, locationInput, descInput].forEach(inp => {
        if (inp) {
          inp.addEventListener('input', updatePreview);
          inp.addEventListener('change', updatePreview);
        }
      });

      // --- Edit mode: preload owned listing ---
      const publishBtn = document.getElementById('publish-btn');
      if (editId) {
        if (publishBtn) publishBtn.textContent = 'Save Changes to Listing';
        fetch(apiUrl + '?action=getProduct&productId=' + encodeURIComponent(editId))
          .then(function(res) { return res.json(); })
          .then(function(json) {
            if (!json.success || !json.data) {
              alert('Listing not found.');
              window.location.href = '/account';
              return;
            }
            const p = json.data;
            if (p.sellerId !== currentUser.userId) {
              alert('You do not own this listing.');
              window.location.href = '/account';
              return;
            }
            if (titleInput) titleInput.value = p.title || '';
            if (categoryInput) categoryInput.value = p.category || '';
            if (brandInput) brandInput.value = p.brand || '';
            if (priceInput) priceInput.value = p.price || '';
            if (yearInput) yearInput.value = p.year || '';
            if (conditionInput) conditionInput.value = p.condition || '';
            if (locationInput) locationInput.value = p.location || '';
            // Compat: listings saved before the provenance column keep it
            // as a trailing "\n\nProvenance: …" suffix — split it back out once.
            let descText = p.description || '';
            let provText = p.provenance || '';
            if (!provText) {
              const split = splitLegacyProvenance(descText);
              descText = split.description;
              provText = split.provenance;
            }
            if (descInput) descInput.value = descText;
            if (provenanceInput) provenanceInput.value = provText;
            if (urlsInput && p.images) urlsInput.value = p.images.join('\n');
            renderThumbnails();
            updatePreview();
          })
          .catch(function() {
            alert('Unable to load listing. Please try again.');
            window.location.href = '/account';
          });
      }

      function setPublishing(busy, label) {
        if (!publishBtn) return;
        publishBtn.disabled = busy;
        publishBtn.textContent = busy ? 'Publishing…' : label;
      }

      // Submit Form & Publish via Products API (Phase 2B)
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();

          const title = titleInput.value.trim();
          const price = Number(priceInput.value);
          if (!title || !price || price <= 0) {
            alert('Please provide a title and a valid valuation.');
            return;
          }

          const imagesToSave = currentImages();

          const payload = {
            sellerId: currentUser.userId,
            title: title,
            category: categoryInput.value,
            brand: brandInput.value.trim(),
            price: price,
            year: yearInput.value.trim(),
            condition: conditionInput.value,
            location: locationInput.value.trim(),
            description: descInput.value.trim(),
            images: imagesToSave,
            provenance: provenanceInput ? provenanceInput.value.trim() : ''
          };

          const isEdit = !!editId;
          setPublishing(true);

          const request = isEdit
            ? fetch(apiUrl, { method: 'POST', body: JSON.stringify({ action: 'updateProduct', productId: editId, ...payload }) })
            : fetch(apiUrl, { method: 'POST', body: JSON.stringify({ action: 'createProduct', ...payload }) });

          request
            .then(function(res) { return res.json(); })
            .then(function(json) {
              setPublishing(false, isEdit ? 'Save Changes to Listing' : 'Publish Listing to Salon');
              if (json.success && json.data) {
                window.dispatchEvent(new CustomEvent('rarivelle:listing-created', { detail: json.data }));
                alert(isEdit ? 'Listing updated.' : 'Your rare collectible listing has been published to RARIVELLE!');
                window.location.href = '/product/' + json.data.productId;
              } else {
                alert(json.error || 'Unable to publish. Please try again.');
              }
            })
            .catch(function() {
              setPublishing(false, isEdit ? 'Save Changes to Listing' : 'Publish Listing to Salon');
              alert('Unable to reach the server. Please try again.');
            });
        });
      }

      // Initial preview render
      updatePreview();
    })();
  </script>
</Layout>
